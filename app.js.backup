// Yanımdaki - Professional Core App Logic (Firebase Integrated)
window.app = window.app || {};
Object.assign(app, {
    utils: typeof utils !== 'undefined' ? utils : {}, // Global utils bağlantısı
    state: typeof app.state !== 'undefined' ? app.state : { // State bütünlüğü koruması
        user: null,
        products: [],
        offers: [],
        favorites: [],
        ratings: [],
        chats: [],
        notifications: [],
        selectedImages: [],
        currentSlide: 0,
        deferredPrompt: null,
        prohibitedKeywords: [],
        radarEnabled: false,
        userLoaded: false, // Firestore kullanıcı dökümanı yüklendi mi?
        lastNotifiedDeals: [] // Daha önce bildirimi gönderilen fırsat ID'leri
    },
    subscriptions: {}, // Aktif Firestore dinleyicilerini tutar
    lastNotification: { title: '', body: '', time: 0 }, // Çift bildirimi önlemek için

    // --- Core Lifecycle ---
    init: function () {
        console.log("Yanımdaki app (Firebase) başlatılıyor...");

        // 0. Firestore Çevrimdışı Kalıcılık (Offline Persistence)
        if (typeof db !== 'undefined' && db.enablePersistence) {
            db.enablePersistence({ synchronizeTabs: true }).catch(err => {
                if (err.code == 'failed-precondition') {
                    console.warn("Persistence failed: Multiple tabs open.");
                } else if (err.code == 'unimplemented') {
                    console.warn("Persistence is not available in this browser.");
                }
            });
        }

        // Native Google Auth'u önceden hazırla (Capacitor için)
        this.initializeGoogleAuth();

        // 1. Kalıcılık Ayarı ve Ardışık Başlatma
        firebase.auth().setPersistence(firebase.auth.Auth.Persistence.LOCAL)
            .then(() => {
                console.log("Auth Persistence set to LOCAL.");

                // 2. ÖNCE Redirect Sonucunu İşle (Mobil Google Login için kritik!)
                return auth.getRedirectResult();
            })
            .then(result => {
                if (result && result.user) {
                    console.log("Google Redirect login success:", result.user.email);
                    this.toast('Google ile giriş başarılı! ✨', 'success');
                    // Redirect başarılıysa, kullanıcı zaten login - auth listener onu yakalayacak
                }

                // 3. Redirect işlendikten SONRA Listener'ı Bağla
                auth.onAuthStateChanged(user => {
                    this.handleAuthStateChange(user);
                });
            })
            .catch(error => {
                console.error("Auth Initialization Error:", error);

                // Hata olsa bile auth listener'ı bağla (normal akış için)
                auth.onAuthStateChanged(user => {
                    this.handleAuthStateChange(user);
                });

                if (error.code !== 'auth/web-storage-unsupported') {
                    // Kullanıcıyı korkutmamak için sadece gerçekten kritik hataları göster
                    if (error.code === 'auth/account-exists-with-different-credential') {
                        this.toast('Bu e-posta ile başka bir giriş yöntemi zaten kayıtlı.', 'error');
                    }
                }
            });

        // --- Kökten Çözüm: Acil Durum Loader Kapatıcı (Fail-Safe) ---
        setTimeout(() => {
            if (document.getElementById('loading-overlay')?.style.display !== 'none') {
                console.log("Fail-Safe: Loader zorla kapatılıyor...");
                this.hideLoader();
            }
        }, 3000);

        // --- Global Error Handler ---
        window.onerror = (message, source, lineno, colno, error) => {
            console.error(`Kritik Uygulama Hatası: ${message}`, error);
            return false;
        };

        const urlParams = new URLSearchParams(window.location.search);

        // --- E-posta Doğrulama Kontrolü ---
        const mode = urlParams.get('mode');
        const oobCode = urlParams.get('oobCode');
        if (mode === 'verifyEmail' && oobCode) {
            this.toast('E-posta adresiniz doğrulanıyor...', 'info');
            auth.applyActionCode(oobCode).then(() => {
                this.toast('E-posta adresiniz başarıyla doğrulandı! ✨', 'success');
                window.history.replaceState({}, document.title, window.location.pathname);
            }).catch(err => {
                this.toast('Doğrulama hatası: ' + err.message, 'error');
            });
        }

        // --- PWA & Service Worker ---
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            this.state.deferredPrompt = e;
        });

        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').then(reg => reg.update());
        }

        // --- Deep Link ---
        const productId = urlParams.get('p');
        if (productId) {
            this.state.deepLinkProduct = productId;
        } else if (window.location.pathname.startsWith('/ilan/')) {
            const pathParts = window.location.pathname.split('/');
            const idFromPath = pathParts[pathParts.length - 1];
            if (idFromPath && idFromPath !== 'ilan') {
                this.state.deepLinkProduct = idFromPath;
            }
        }

        // --- Structured Initialization ---
        this.populateCityFilters();
        this.initIntervals();
        this.initPWA();
        this.setupOnboardingSwipe();
        this.initDarkMode();
        this.checkAppDownloadPrompt();
    },

    // Native Google Auth Başlatıcı (Capacitor Android için)
    initializeGoogleAuth: async function () {
        const isNative = window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform();
        if (!isNative) return;

        try {
            const GoogleAuth = window.Capacitor.Plugins.GoogleAuth;
            if (GoogleAuth) {
                await GoogleAuth.initialize({
                    clientId: '231861965178-78t998edq2lkq22a0olirso03tunhpt0.apps.googleusercontent.com',
                    serverClientId: '231861965178-78t998edq2lkq22a0olirso03tunhpt0.apps.googleusercontent.com',
                    scopes: ['profile', 'email'],
                    grantOfflineAccess: true,
                });
                console.log("Native Google Auth initialized. ✅");
            }
        } catch (e) {
            console.error('Google Auth başlatılırken hata:', e);
        }
    },

    // Yeni yardımcı fonksiyon: Auth state değişikliklerini merkezi yönetir
    handleAuthStateChange: function (user) {
        try {
            if (user) {
                console.log("Auth State: User is logged in", user.uid);
                const isGoogle = user.providerData.some(p => p.providerId === 'google.com');

                if (!this.state.user || this.state.user.uid !== user.uid) {
                    this.state.user = {
                        uid: user.uid,
                        email: user.email,
                        emailVerified: user.emailVerified || isGoogle,
                        displayName: user.displayName || localStorage.getItem('lastLoginName') || 'Kullanıcı',
                        photoURL: user.photoURL,
                        location: { lat: 41.0082, lng: 28.9784 },
                        trustScore: 0,
                        neighborCount: 0,
                        verifiedNeighbor: false
                    };
                } else {
                    // Mevcut verileri koru, sadece Auth alanlarını güncelle
                    this.state.user.email = user.email;
                    this.state.user.emailVerified = user.emailVerified || isGoogle;
                    if (user.displayName) this.state.user.displayName = user.displayName;
                    if (user.photoURL) this.state.user.photoURL = user.photoURL;
                }

                const userRef = db.collection('users').doc(user.uid);
                userRef.onSnapshot(async doc => {
                    if (doc.exists) {
                        const data = doc.data();
                        console.log("[App Debug] User document updated:", data.partnerStatus);
                        this.state.user = { ...this.state.user, ...data };
                        this.state.userLoaded = true;
                        this.renderProfile();
                        this.renderSettings();
                        this.checkPhoneWarning();

                        // Canlı Radar Aktivasyonu
                        this.updateLiveRadar();
                        if (!this._radarInterval) {
                            this._radarInterval = setInterval(() => {
                                this.updateLiveRadar();
                            }, 30000);
                        }

                        // Eğer mesajlar ekranındaysak listeyi yenile
                        if (this.currentScreen === 'messages') {
                            this.renderMessages();
                        }
                    } else {
                        await userRef.set({
                            email: user.email || "",
                            displayName: user.displayName || localStorage.getItem('lastLoginName') || "Kullanıcı",
                            photoURL: user.photoURL || "",
                            adLimit: 50,
                            isAdmin: false,
                            trustScore: 0,
                            neighborCount: 0,
                            verifiedNeighbor: false,
                            createdAt: firebase.firestore.FieldValue.serverTimestamp()
                        }, { merge: true });
                    }
                });

                this.syncData();
                this.syncSubscriptions();
                this.loadLocationData();
                this.populateCityFilters();
                this.updateUserLocation();

                // Login sonrası kampanyayı tekrar tetikle
                sessionStorage.removeItem('campaignShown');
                setTimeout(() => {
                    if (typeof this.checkAndShowCampaign === 'function') {
                        this.checkAndShowCampaign();
                    }
                }, 2000);

                try { this.initMessaging(); } catch (e) { }

                // Giriş yapıldıktan sonra ana sayfaya yönlendir
                // Giriş yapıldıktan sonra varsa kaldığı sayfaya, yoksa ana sayfaya yönlendir
                const savedScreen = localStorage.getItem('activeScreen');
                if (savedScreen && savedScreen !== 'login') {
                    this.showScreen(savedScreen);
                } else {
                    this.showScreen('home');
                }
            } else {
                console.log("Auth State: User is logged out");
                this.state.user = null;
                this.state.userLoaded = false;
                this.syncData();
                this.renderProfile();
                this.renderSettings();
                this.checkPhoneWarning();

                // Guest onboarding/home redirect
                if (!localStorage.getItem('onboardingCompleted')) {
                    this.showScreen('onboarding');
                } else {
                    this.loadLocationData();
                    this.populateCityFilters();
                    const savedScreen = localStorage.getItem('activeScreen');
                    if (savedScreen && savedScreen !== 'login') {
                        this.showScreen(savedScreen);
                    } else {
                        this.showScreen('home');
                    }
                }
            }
            this.hideLoader();
        } catch (e) {
            console.error("handleAuthStateChange Error:", e);
            this.hideLoader();
        }
    },

    initIntervals: function () {
        // Her dakika sayaçları güncellemek için zamanlayıcı
        setInterval(() => {
            if (this.state.products.length > 0) {
                this.renderProducts();
                const detailModal = document.getElementById('product-detail-modal');
                if (detailModal && detailModal.style.display === 'block' && this.currentProductId) {
                    this.showProductDetails(this.currentProductId);
                }
            }
        }, 60000);
    },

    initPWA: function () {
        // --- PWA Install Logic ---
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            this.state.deferredPrompt = e;
            const installBtn = document.getElementById('pwa-install-btn');
            if (installBtn) installBtn.style.setProperty('display', 'flex', 'important');
        });

        window.addEventListener('appinstalled', () => {
            this.state.deferredPrompt = null;
            const installBtn = document.getElementById('pwa-install-btn');
            if (installBtn) installBtn.style.display = 'none';
            this.toast('Yanımdaki başarıyla yüklendi! 🎉');
        });
    },

    // --- App Download Prompt (Mobile) ---
    checkAppDownloadPrompt: function () {
        // Sadece mobilde ve PWA olarak açılmamışsa göster
        const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        const isPWA = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
        const isHidden = localStorage.getItem('hideAppPrompt');
        const isNative = window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform();

        // APK (Native) içerisindeysek veya zaten PWA ise veya gizlendiyse gösterme
        if (isMobile && !isPWA && !isHidden && !isNative) {
            setTimeout(() => {
                const overlay = document.getElementById('app-download-overlay');
                if (overlay) {
                    overlay.style.display = 'flex';
                }
            }, 2000); // 2 saniye sonra göster
        }
    },

    closeAppDownloadPrompt: function (permanent = false) {
        const overlay = document.getElementById('app-download-overlay');
        if (overlay) {
            overlay.style.display = 'none';
        }
        if (permanent) {
            localStorage.setItem('hideAppPrompt', 'true');
        }
    },

    downloadAPK: async function () {
        const isPWA = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;

        if (isPWA) {
            this.toast('Yanımdaki zaten yüklü! 🎉', 'success');
            this.closeAppDownloadPrompt(true);
            return;
        }

        if (this.state.deferredPrompt) {
            this.state.deferredPrompt.prompt();
            const { outcome } = await this.state.deferredPrompt.userChoice;
            console.log(`User response to the install prompt: ${outcome}`);
            this.state.deferredPrompt = null;
            this.closeAppDownloadPrompt(outcome === 'accepted');
        } else {
            this.toast('Yükleme şu an başlatılamıyor. Tarayıcı menüsünden "Ana Ekrana Ekle"yi kullanabilirsiniz.', 'info');
            // Permanently hide if they got the message but can't install via button
            this.closeAppDownloadPrompt(true);
        }
    },

    initMessaging: function () {
        // --- Capacitor Native Support ---
        if (window.Capacitor && window.Capacitor.isNativePlatform()) {
            this.initCapacitorNotifications();
            return;
        }

        if (!messaging) return;

        // Ön planda mesaj gelince (Web)
        messaging.onMessage((payload) => {
            console.log("Foreground message received:", payload);
            this.sendLocalNotification(payload.notification.title, payload.notification.body, payload.data);
        });

        // İzin iste (Web)
        this.requestNotificationPermission();
    },

    initCapacitorNotifications: async function () {
        const { PushNotifications } = Capacitor.Plugins;

        // İzin kontrolü ve isteme
        let permStatus = await PushNotifications.checkPermissions();
        if (permStatus.receive === 'prompt') {
            permStatus = await PushNotifications.requestPermissions();
        }

        if (permStatus.receive !== 'granted') {
            return console.warn('User denied push permissions!');
        }

        // Kayıt ol
        await PushNotifications.register();

        // Token alındığında
        PushNotifications.addListener('registration', (token) => {
            console.log('Capacitor Push Token:', token.value);
            if (this.state.user) {
                db.collection('users').doc(this.state.user.uid).update({
                    fcmToken: token.value,
                    platform: Capacitor.getPlatform()
                });
            }
        });

        // Hata durumunda
        PushNotifications.addListener('registrationError', (err) => {
            console.error('Capacitor Registration Error:', err);
        });

        // Bildirim geldiğinde (Foreground)
        PushNotifications.addListener('pushNotificationReceived', (notification) => {
            this.sendLocalNotification(notification.title, notification.body, notification.data);
        });

        // Bildirime tıklandığında
        PushNotifications.addListener('pushNotificationActionPerformed', (notification) => {
            console.log('Push action performed:', notification.actionId);
            // Belirli bir ekrana yönlendirme yapılabilir
        });
    },

    requestNotificationPermission: function () {
        if (!messaging) return;

        Notification.requestPermission().then((permission) => {
            if (permission === 'granted') {
                console.log('Notification permission granted.');
                this.saveToken();
            } else {
                console.warn('Unable to get permission to notify.');
            }
        });
    },

    saveToken: function () {
        messaging.getToken({ vapidKey: 'BIsS-m_vH6X8Wp6m9C4yH7y_z-Rzq_Z8Wp6m9C4yH7y' }).then((currentToken) => {
            if (currentToken) {
                console.log('FCM Token:', currentToken);
                if (this.state.user) {
                    db.collection('users').doc(this.state.user.uid).update({
                        fcmToken: currentToken,
                        platform: 'web'
                    });
                }
            } else {
                console.warn('No registration token available. Request permission to generate one.');
            }
        }).catch((err) => {
            console.error('An error occurred while retrieving token. ', err);
        });
    },

    updateNotificationBadge: function () {
        const badge = document.getElementById('notification-badge');
        if (!badge) return;
        const count = this.state.notifications.length;
        if (count > 0) {
            badge.textContent = count;
            badge.style.display = 'block';
        } else {
            badge.style.display = 'none';
        }
    },

    sendLocalNotification: function (title, body, data = {}) {
        // Çıkış (Deduplication): Aynı bildirimi 2 saniye içinde tekrar gösterme
        const now = Date.now();
        if (this.lastNotification.title === title && this.lastNotification.body === body && (now - this.lastNotification.time < 2000)) {
            console.log("Deduplicated notification:", title);
            return;
        }
        this.lastNotification = { title, body, time: now };

        console.log("sendLocalNotification triggered:", { title, body, data });
        // Tarayıcı içi toast göster
        this.toast(`${title}: ${body}`, 'info');

        // State'e ekle (UI listesi için)
        this.state.notifications.unshift({
            id: Date.now(),
            title: title,
            text: body,
            type: data.type || 'info',
            timestamp: new Date(),
            productId: data.productId || null,
            otherPhone: data.otherPhone || null
        });
        this.updateNotificationBadge();

        // Eğer izin varsa browser seviyesinde bildirim (OS)
        if (window.Notification && Notification.permission === 'granted') {
            try {
                new Notification(title, {
                    body: body,
                    icon: '/icon.png',
                    tag: data.productId || 'general'
                });
            } catch (err) {
                console.warn("Notification error (might be on mobile browser):", err);
            }
        }
    },

    // --- Side Menu Accordion ---
    toggleCategoryAccordion: function () {
        const btn = document.getElementById('side-menu-categories-btn');
        const list = document.getElementById('side-menu-categories-list');
        if (!btn || !list) return;

        const isActive = btn.classList.contains('active-acc');

        if (isActive) {
            btn.classList.remove('active-acc');
            list.style.maxHeight = '0';
        } else {
            // Diğer açık akordiyonları kapatmak isterseniz buraya mantık ekleyebilirsiniz
            btn.classList.add('active-acc');
            list.style.maxHeight = list.scrollHeight + 'px';
        }
    },

    toggleSidebarAccordion: function () {
        const body = document.getElementById('sidebar-features-body');
        const header = document.querySelector('.accordion-header-custom');
        if (!body || !header) return;

        const isActive = header.classList.contains('active');

        if (isActive) {
            header.classList.remove('active');
            body.style.maxHeight = '0';
        } else {
            header.classList.add('active');
            body.style.maxHeight = body.scrollHeight + 'px';
        }
    },

    filterByCategory: function (catId) {
        this.setCategory(catId);
        this.showScreen('home');
        // Liste görünümüne odaklan
        const productList = document.getElementById('product-list');
        if (productList) productList.scrollIntoView({ behavior: 'smooth' });
    },

    // --- Data synchronization moved to js/data.js ---


    // --- Navigation ---
    showScreen: function (screenId) {
        // Giriş gerektiren sayfalar için kontrol
        const protectedScreens = ['add', 'offers', 'profile', 'messages', 'settings', 'my-ads', 'my-offers', 'favorites', 'esnaf-panel'];
        if (protectedScreens.includes(screenId) && !this.state.user) {
            this.showScreen('login');
            this.switchLoginTab('register');
            const messages = {
                'add': 'İlan vermek için lütfen kayıt olun veya giriş yapın.',
                'messages': 'Mesajlarınızı görmek için lütfen giriş yapın.',
                'offers': 'Tekliflerinizi yönetmek için lütfen giriş yapın.',
                'profile': 'Profilinizi görmek için lütfen giriş yapın.'
            };
            this.toast(messages[screenId] || 'Bu sayfaya erişmek için lütfen giriş yapın.', 'info');
            return;
        }

        // --- NEW: Askıda flow cleanup when leaving 'add' screen ---
        if (screenId !== 'add' && this.pendingAskidaData) {
            this.pendingAskidaData = null;
            const adTypeSelect = document.getElementById('add-ad-type');
            if (adTypeSelect) adTypeSelect.disabled = false;
            // Optionally reset category if it was Askıda
            const catSelect = document.getElementById('add-category');
            if (catSelect && catSelect.value === 'Askıda') {
                catSelect.value = '';
                this.handleCategoryChange(); // handleCategoryChange resets other locks
            }
        }

        this.currentScreen = screenId;
        if (screenId !== 'login' && screenId !== 'onboarding') {
            localStorage.setItem('activeScreen', screenId);
        }

        // İletişim ekranına başka yerden (örneğin galeri modalı) gelinmediyse origin'i sıfırla
        if (screenId === 'contact') {
            const adNumGroup = document.getElementById('contact-ad-number-group');
            if (adNumGroup) {
                adNumGroup.style.display = this.contactOrigin === 'gallery' ? 'block' : 'none';
            }
        } else if (this.contactOrigin) {
            this.contactOrigin = null;
        }

        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        const target = document.getElementById(`screen-${screenId}`);
        if (target) target.classList.add('active');

        const navBar = document.getElementById('main-nav');
        const header = document.querySelector('header');
        if (screenId === 'login' || screenId === 'onboarding') {
            if (navBar) navBar.style.display = 'none';
            if (header) header.style.display = 'none';
        } else {
            if (navBar) navBar.style.display = 'flex';
            if (header) header.style.display = 'flex';

            // Alt menü aktiflik durumu
            document.querySelectorAll('#main-nav a, #main-nav .nav-item').forEach(item => {
                item.classList.remove('active');
                if (item.getAttribute('onclick').includes(`'${screenId}'`)) {
                    item.classList.add('active');
                }
            });
        }

        // Ekran değiştiğinde loader'ın kapandığından emin ol
        this.hideLoader();

        if (screenId === 'home') {
            this.renderCategoryBar();
            this.renderProducts();
            this.renderHeroSlider();
            this.updateSustainabilityStats();
        }
        if (screenId === 'add') {
            this.updateAdQuota();
            this.updateAddScreenVitrineOptions();
        }
        if (screenId === 'esnaf-panel') {
            this.renderEsnafPanel();
        }
        if (screenId === 'quick-deal') {
            this.updateQuickDealVitrineOptions();
        }
        if (screenId === 'offers') this.renderOffers();
        if (screenId === 'profile') this.renderProfile();
        if (screenId === 'messages') this.renderMessages();
        if (screenId === 'settings') this.renderSettings();
        if (screenId === 'my-ads') this.renderMyAds();
        if (screenId === 'my-offers') this.renderMyOffers();
        if (screenId === 'map') this.initLiveMap();
        if (screenId === 'share') this.renderShareFeed();
        if (screenId === 'favorites') this.renderFavorites();

        if (target) target.scrollTop = 0;
    },

    // --- Gallery Logic ---
    renderGallery: function () {
        const wrapper = document.getElementById('gallery-wrapper');
        const section = document.getElementById('gallery-container');
        if (!wrapper || !section) return;

        // Arama filtresi
        const searchLower = this.state.filters.searchQuery.toLowerCase();

        const items = (this.state.galleryItems || []).filter(item => {
            const product = this.state.products.find(p => p.id === item.productId);
            if (!product) return false;

            // Hem vitrin paketinin hem de ürünün süresi dolmamış olmalı
            const isProductExpired = this.utils.isProductExpired(product);
            const isVitrineExpired = item.expiresAt && item.expiresAt.seconds < firebase.firestore.Timestamp.now().seconds;

            if (isProductExpired || isVitrineExpired) return false;

            // Bireysel vitrin sadece komsu ürünlerini göstersin (esnaf olmayan)
            const isEsnaf = item.vitrineType === 'esnaf';
            if (isEsnaf) return false;

            // Arama filtresi uygula
            const matchesSearch = product.title.toLowerCase().includes(searchLower);

            // Şehir filtresi uygula
            const f = this.state.filters;
            const matchesLocation = f.city === 'all' || product.city === f.city;

            return matchesSearch && matchesLocation;
        });

        // Bireysel vitrin boşsa CTA placeholder kartı göster
        if (items.length === 0) {
            section.style.display = 'block';
            wrapper.innerHTML = `
                <div class="vitrine-placeholder-card vitrine-placeholder-komsu" onclick="app.openGalleryInfoModal('komsu')">
                    <div class="vitrine-placeholder-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="vitrine-placeholder-content">
                        <h4>Bireysel Vitrin</h4>
                        <p>İlanınızı öne çıkararak daha fazla alıcıya ulaşın!</p>
                        <span class="vitrine-placeholder-cta">Vitrine İlan Ver <i class="fas fa-arrow-right"></i></span>
                    </div>
                </div>
            `;
            return;
        }

        section.style.display = 'block';

        wrapper.innerHTML = items.map(item => {
            const product = this.state.products.find(p => p.id === item.productId);

            // Fiyat etiketini hesapla
            let priceVal = parseFloat(product.price) || 0;
            let oldPriceVal = parseFloat(product.oldPrice) || 0;
            if (isNaN(priceVal)) priceVal = 0;
            if (isNaN(oldPriceVal)) oldPriceVal = 0;

            let priceHtml = '';
            if (oldPriceVal > 0 && priceVal < oldPriceVal) {
                priceHtml = `<span class="old-price">${oldPriceVal}₺</span>${priceVal}₺`;
            } else {
                priceHtml = `${product.isFree ? 'Hediye' : priceVal + '₺'}`;
            }

            // Rating hesaplama
            const productRatings = this.state.ratings.filter(r => r.productId === product.id || r.userId === product.ownerId);
            const avgRating = productRatings.length > 0
                ? (productRatings.reduce((sum, r) => sum + (r.rating || 0), 0) / productRatings.length).toFixed(1)
                : 0;
            const ratingCount = productRatings.length;

            // Yıldız HTML oluştur
            const starsHtml = `
                <div class="card-rating">
                    <div class="card-rating-stars">
                        ${[1, 2, 3, 4, 5].map(i => `<i class="fas fa-star ${i <= Math.round(avgRating) ? (i === 5 && avgRating >= 4.5 ? 'highlight' : '') : 'empty'}"></i>`).join('')}
                    </div>
                    <span class="card-rating-value">${avgRating > 0 ? avgRating.toString().replace('.', ',') : '0,0'}</span>
                    <span class="card-rating-count">(${ratingCount})</span>
                </div>
            `;

            // Geri sayım sayacı - Ürün ömrü ve vitrin ömründen en kısası alınır
            const expiresAt = this.utils.getShortestExpiry(item, product);

            const getCountdownHtml = (expires) => {
                if (!expires) return '';
                const diff = expires - new Date();
                if (diff <= 0) return '<span class="countdown-badge expired"><i class="fas fa-clock"></i> Süresi Doldu</span>';

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

                let timeStr = "";
                if (days > 0) timeStr = `${days}g ${hours}s`;
                else timeStr = `${hours > 0 ? hours + 's ' : ''}${mins}dk`;

                const isUrgent = days === 0 && hours < 1;

                return `<span class="countdown-badge ${isUrgent ? 'urgent' : ''}" data-expires="${expires.getTime()}">
                    <i class="fas fa-clock"></i> ${timeStr}
                </span>`;
            };

            const countdownHtml = getCountdownHtml(expiresAt);

            return `
                <div class="esnaf-compact-card ${product.isSurprise ? 'is-surprise' : ''}" onclick="app.showProductDetails('${product.id}')" style="min-width: 150px; scroll-snap-align: start;">
                    <div class="esnaf-compact-img" style="background-image: url('${this.utils.getProductImage(product)}');">
                        <span class="esnaf-compact-badge" style="background: linear-gradient(135deg, #FF8F1F, #E67E22)">
                            <i class="fas fa-star"></i> VİTRİN
                        </span>
                        <span class="esnaf-compact-price-tag">${priceHtml}</span>
                        ${product.delivery ? `
                            <div style="position: absolute; bottom: 8px; left: 8px; background: rgba(0, 168, 150, 0.85); color: white; width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; backdrop-filter: blur(4px); z-index: 2;">
                                <i class="fas ${product.delivery === 'kapidan' ? 'fa-door-open' : (product.delivery === 'ortak-nokta' ? 'fa-map-pin' : 'fa-shop')}"></i>
                            </div>
                        ` : ''}
                    </div>
                    <div class="esnaf-compact-info">
                        <div class="esnaf-compact-title">${this.utils.escapeHTML(product.title)}</div>
                        ${product.dealType && product.dealType !== 'none' ? `
                            <div class="esnaf-deal-label-red">
                                ${product.dealType === 'indirim' ? 'İNDİRİM' : (product.dealType === 'serisonu' ? 'SERİ SONU' : 'TEŞHİR ÜRÜNÜ')}
                            </div>
                        ` : ''}
                        <div class="esnaf-compact-location">
                            <i class="fas fa-location-dot"></i>
                            <span>${this.utils.escapeHTML(product.city || 'Yakınında')}</span>
                        </div>
                        ${starsHtml}
                        <div class="esnaf-compact-shop" style="display: flex; align-items: center; gap: 4px;">
                            <i class="fas fa-user" style="font-size: 0.75rem; color: var(--text-muted);"></i>
                            <span style="font-size: 0.75rem; color: var(--text-muted);">${this.utils.escapeHTML(product.ownerName || 'Kullanıcı')}</span>
                            ${product.isOwnerVerified ? '<span class="verified-badge small" title="Onaylı Profil"><i class="fas fa-check-circle"></i></span>' : ''}
                        </div>
                        ${countdownHtml}
                    </div>
                </div>
            `;
        }).join('');
    },

    selectGalleryPackage: function (pkg, el) {
        this.state.selectedGalleryPackage = pkg;

        // UI Güncelleme
        document.querySelectorAll('.pricing-card').forEach(card => {
            card.classList.remove('selected');
        });
        el.classList.add('selected');

        // Buton metnini güncelle (opsiyonel)
        const cta = document.getElementById('gallery-info-cta');
        if (cta) cta.innerHTML = `Paketi Seç ve Devam Et (${pkg}) 🚀`;
    },

    selectVitrineType: function (type, el) {
        this.state.selectedVitrineType = type;

        // UI Güncelleme
        document.querySelectorAll('.vitrine-type-card').forEach(card => {
            card.classList.remove('selected');
            card.style.border = '2px solid var(--border-color)';
            card.style.background = 'white';
        });
        el.classList.add('selected');
        if (type === 'komsu') {
            el.style.border = '2px solid #FF8F1F';
            el.style.background = '#fff7ed';
        } else {
            el.style.border = '2px solid #14b8a6';
            el.style.background = '#f0fdfa';
        }
    },

    handleGalleryReservation: function () {
        // Eski yöntem yerine ödeme modalını açıyoruz
        this.openPaymentModal();
    },

    openPaymentModal: function () {
        const pkg = this.state.selectedGalleryPackage || 'haftalık';
        const vitrineType = this.state.selectedVitrineType || 'komsu';

        const prices = {
            'günlük': 20,
            'haftalık': 80,
            'aylık': 200
        };

        const amount = prices[pkg] || 0;
        const packageName = `${pkg.charAt(0).toUpperCase() + pkg.slice(1)} ${vitrineType === 'esnaf' ? 'Esnaf' : 'Bireysel'} Vitrin`;

        document.getElementById('payment-amount').textContent = `${amount} TL`;
        document.getElementById('payment-package-name').textContent = packageName;

        // Açıklama kodunu oluştur (ad-Premium yerine daha spesifik)
        const userPrefix = this.state.user ? this.state.user.phone.slice(-4) : '0000';
        document.getElementById('payment-description').textContent = `vitrin-${vitrineType}-${userPrefix}`;

        document.getElementById('modal-payment').style.display = 'flex';
        document.getElementById('modal-gallery-info').style.display = 'none';

        // Sıfırla
        document.getElementById('receipt-input').value = '';
        document.getElementById('receipt-preview').style.display = 'none';
        this.state.selectedReceipt = null;
    },

    closePaymentModal: function () {
        document.getElementById('modal-payment').style.display = 'none';
    },

    handleReceiptSelect: function (e) {
        const file = e.target.files[0];
        if (!file) return;

        if (file.size > 5 * 1024 * 1024) {
            this.toast('Dosya boyutu 5MB\'dan büyük olamaz.', 'error');
            return;
        }

        const reader = new FileReader();
        reader.onload = async (event) => {
            try {
                const compressed = await this.utils.compressImage(event.target.result, 800, 800, 0.6);
                const preview = document.getElementById('receipt-preview');
                preview.querySelector('img').src = compressed;
                preview.style.display = 'block';
                this.state.selectedReceipt = compressed;
            } catch (err) {
                console.error("Receipt compression error:", err);
                const preview = document.getElementById('receipt-preview');
                preview.querySelector('img').src = event.target.result;
                preview.style.display = 'block';
                this.state.selectedReceipt = event.target.result;
            }
        };
        reader.readAsDataURL(file);
    },

    submitPayment: async function () {
        if (!this.state.user) {
            this.toast('Lütfen önce giriş yapın.', 'info');
            return;
        }

        if (!this.state.selectedReceipt) {
            this.toast('Lütfen ödeme dekontunu yükleyin.', 'error');
            return;
        }

        const pkg = this.state.selectedGalleryPackage || 'haftalık';
        const vitrineType = this.state.selectedVitrineType || 'komsu';
        const amount = document.getElementById('payment-amount').textContent;

        try {
            this.toast('Ödeme bildiriminiz gönderiliyor...', 'info');

            const application = {
                userId: this.state.user.uid,
                userName: this.state.user.displayName || 'İsimsiz',
                userPhone: this.state.user.phone || '',
                productId: this.state.currentVitrineProductId || null,
                package: pkg,
                vitrineType: vitrineType,
                amount: amount,
                receiptImage: this.state.selectedReceipt, // Base64 (Prod'da Storage önerilir)
                type: 'gallery_application',
                status: 'pending',
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            };

            await db.collection('contact_messages').add(application);

            this.toast('Ödeme bildiriminiz alındı! Admin onayından sonra paketiniz aktifleşecektir.', 'success');
            this.closePaymentModal();
        } catch (err) {
            console.error("Payment Error:", err);
            this.toast('Bir hata oluştu, lütfen tekrar deneyin.', 'error');
        }
    },

    // --- GÜVENLİ NOKTA (PARTNER) BAŞVURU MANTIĞI ---
    openPartnerApplicationModal: function () {
        if (!this.state.user) {
            this.toast('Başvuru için lütfen giriş yapın.', 'info');
            this.auth.openAuthModal();
            return;
        }

        // Modal hazırlığı
        const desc = "partner-" + Math.floor(1000 + Math.random() * 9000);
        document.getElementById('partner-payment-desc').textContent = desc;
        this.state.selectedPartnerReceipt = null;
        this.state.partnerLocation = null;

        document.getElementById('partner-receipt-preview').style.display = 'none';
        document.getElementById('partner-location-status').textContent = 'Konumunuz Henüz Alınmadı';
        document.getElementById('partner-location-status').style.color = '#0369a1';

        document.getElementById('modal-partner-application').style.display = 'flex';
        // Vitrin bilgilendirme modalını kapat
        this.closeGalleryInfoModal();
    },

    closePartnerApplicationModal: function () {
        document.getElementById('modal-partner-application').style.display = 'none';
    },

    getPartnerLocation: function () {
        this.toast('Konumunuz alınıyor...', 'info');
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    this.state.partnerLocation = {
                        lat: position.coords.latitude,
                        lng: position.coords.longitude
                    };
                    const status = document.getElementById('partner-location-status');
                    status.textContent = 'Konum Başarıyla Alındı ✓';
                    status.style.color = '#10b981';
                    this.toast('Konum başarıyla alındı.', 'success');
                },
                (error) => {
                    console.error("Geolocation error:", error);
                    let msg = 'Konum alınamadı. ';
                    if (error.code === error.TIMEOUT) msg += 'İşlem zaman aşımına uğradı. Lütfen tekrar deneyin.';
                    else if (error.code === error.PERMISSION_DENIED) msg += 'Lütfen konum izinlerini kontrol edin.';
                    else if (error.code === error.POSITION_UNAVAILABLE) msg += 'Konum bilgisi şu an ulaşılamaz durumda.';
                    else msg += error.message;

                    this.toast(msg, 'error');
                },
                { enableHighAccuracy: false, timeout: 15000, maximumAge: 0 }
            );
        } else {
            this.toast('Tarayıcınız konum özelliğini desteklemiyor.', 'error');
        }
    },

    handlePartnerReceiptSelect: function (event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = async (e) => {
            try {
                const compressed = await this.utils.compressImage(e.target.result, 800, 800, 0.7);
                const preview = document.getElementById('partner-receipt-preview');
                preview.querySelector('img').src = compressed;
                preview.style.display = 'block';
                this.state.selectedPartnerReceipt = compressed;
            } catch (err) {
                this.state.selectedPartnerReceipt = e.target.result;
            }
        };
        reader.readAsDataURL(file);
    },

    submitPartnerApplication: async function () {
        const businessName = document.getElementById('partner-business-name').value.trim();
        const contactName = document.getElementById('partner-contact-name').value.trim();
        const contactPhone = document.getElementById('partner-contact-phone').value.trim();
        const address = document.getElementById('partner-business-address').value.trim();
        const receipt = this.state.selectedPartnerReceipt;
        const location = this.state.partnerLocation;

        if (!businessName || !contactName || !contactPhone || !address) {
            this.toast('Lütfen tüm işletme ve yetkili bilgilerini doldurun.', 'error');
            return;
        }
        if (!location) {
            this.toast('Lütfen işletme konumunu butona basarak alın.', 'error');
            return;
        }
        if (!receipt) {
            this.toast('Lütfen ödeme dekontunu yükleyin.', 'error');
            return;
        }

        try {
            this.toast('Başvurunuz gönderiliyor...', 'info');

            const application = {
                userId: this.state.user.uid,
                userName: this.state.user.displayName || 'İsimsiz',
                userPhone: this.state.user.phone || '',
                businessName,
                contactName,
                contactPhone,
                address,
                lat: location.lat,
                lng: location.lng,
                receiptImage: receipt,
                status: 'pending',
                amount: '200₺',
                paymentType: 'partner',
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            };

            await db.collection('partner_applications').add(application);

            // Kullanıcı durumunu beklemede yap
            await db.collection('users').doc(this.state.user.uid).set({
                partnerStatus: 'pending'
            }, { merge: true });

            this.toast('Başvurunuz alındı! İnceleme sonrası size bilgi verilecektir.', 'success');
            this.closePartnerApplicationModal();
        } catch (err) {
            console.error("Partner Application Error:", err);
            this.toast('Bir hata oluştu: ' + err.message, 'error');
        }
    },

    copyIban: function () {
        const iban = "TR87 0046 0001 3688 8000 1294 17";
        navigator.clipboard.writeText(iban).then(() => {
            this.toast('IBAN kopyalandı!', 'success');
        });
    },

    syncSubscriptions: function () {
        if (!this.state.user) return;

        // Kullanıcının aboneliklerini dinle (users koleksiyonu içinde bir array olduğunu varsayıyoruz)
        db.collection('users').doc(this.state.user.uid).onSnapshot(doc => {
            if (doc.exists) {
                this.state.subscriptions = doc.data().activeSubscriptions || [];
                this.renderSubscriptions();
                this.updateAddScreenVitrineOptions();
                this.updateQuickDealVitrineOptions();
            }
        });
    },

    renderSubscriptions: function () {
        const container = document.getElementById('subscription-list');
        const section = document.getElementById('profile-subscriptions');
        if (!container || !section) return;

        // Esnaf paketlerini artık panelde gösteriyoruz, profil kısmından kaldırıyoruz
        const individualSubs = (this.state.subscriptions || []).filter(s => s.vitrineType !== 'esnaf');

        if (individualSubs.length === 0) {
            section.style.display = 'none';
            return;
        }

        section.style.display = 'block';
        container.innerHTML = individualSubs.map((s, idx) => {
            const expiresAt = s.expiresAt && s.expiresAt.toDate ? s.expiresAt.toDate() : new Date(s.expiresAt);
            const isExpired = expiresAt < new Date();

            if (isExpired) return '';

            const colors = s.vitrineType === 'esnaf' ? ['#14b8a6', '#0d9488'] : ['#FF8F1F', '#e67e22'];
            const title = `${s.package === 'aylık' ? 'Altın' : s.package === 'haftalık' ? 'Gümüş' : 'Standart'} ${s.vitrineType === 'esnaf' ? 'Esnaf' : 'Bireysel'} Paketi`;

            return `
                <div class="subscription-card">
                    <div class="subscription-header">
                        <span class="subscription-title">${title}</span>
                        <span class="subscription-badge" style="background: linear-gradient(135deg, ${colors[0]}, ${colors[1]})">${s.vitrineType}</span>
                    </div>
                    <div class="subscription-timer" id="sub-timer-${idx}" data-expires="${expiresAt.getTime()}">
                        <i class="fas fa-clock"></i> --:--:--
                    </div>
                </div>
            `;
        }).join('');

        this.startSubscriptionTimers();
    },

    startSubscriptionTimers: function () {
        if (this._subTimerInterval) clearInterval(this._subTimerInterval);

        const update = () => {
            document.querySelectorAll('[id^="sub-timer-"], [id^="esnaf-sub-timer-"], [id^="ind-sub-timer-"]').forEach(el => {
                const expires = parseInt(el.dataset.expires);
                const now = new Date().getTime();
                const diff = expires - now;

                if (diff <= 0) {
                    el.innerHTML = '<i class="fas fa-exclamation-circle"></i> Süresi Doldu';
                    return;
                }

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const secs = Math.floor((diff % (1000 * 60)) / 1000);

                el.innerHTML = `<i class="fas fa-clock"></i> ${days > 0 ? days + 'g ' : ''}${hours.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            });
        };

        update();
        this._subTimerInterval = setInterval(update, 1000);
    },

    updateAddScreenVitrineOptions: function () {
        if (!this.state.user) return;

        const esnafContainer = document.getElementById('vitrine-add-esnaf');
        const individualContainer = document.getElementById('vitrine-add-individual');
        const posterProfileSelection = document.getElementById('poster-profile-selection');
        const isApprovedEsnaf = (this.state.user.esnafStatus || '').toLowerCase() === 'approved';

        const subs = this.state.subscriptions || [];
        const now = new Date();

        // Profil Seçimi Görünürlüğü (Sadece onaylı esnaflar için)
        if (posterProfileSelection) {
            posterProfileSelection.style.display = isApprovedEsnaf ? 'block' : 'none';
            // Standart akıştan gelen profile göre ayarla
            const currentFlow = this.state.currentAdFlow || 'individual';
            this.setPosterProfile(currentFlow);
        }

        if (esnafContainer) {
            const activeEsnafSub = subs.find(s => {
                const expiresAt = s.expiresAt && s.expiresAt.toDate ? s.expiresAt.toDate() : new Date(s.expiresAt);
                return s.vitrineType === 'esnaf' && expiresAt > now;
            });
            const hasActiveEsnaf = !!activeEsnafSub;

            esnafContainer.style.display = 'block';
            const esnafCheck = document.getElementById('add-is-vitrine-esnaf');
            const esnafStatus = esnafContainer.querySelector('span:last-child');

            if (esnafCheck) {
                esnafCheck.disabled = !hasActiveEsnaf;
                esnafCheck.checked = false;
            }
            if (esnafStatus) {
                if (hasActiveEsnaf) {
                    const expiry = activeEsnafSub.expiresAt && activeEsnafSub.expiresAt.toDate ? activeEsnafSub.expiresAt.toDate() : new Date(activeEsnafSub.expiresAt);
                    esnafStatus.innerHTML = `Aktif paketiniz kullanılıyor. Bitiş: ${expiry.toLocaleDateString('tr-TR')}`;
                    esnafStatus.style.color = '#14b8a6';
                    esnafContainer.style.opacity = '1';
                } else {
                    esnafStatus.innerHTML = 'Aktif esnaf vitrin paketiniz bulunmuyor. <small>(Pasif)</small>';
                    esnafStatus.style.color = '#ef4444';
                    esnafContainer.style.opacity = '0.6';
                    // Paket yoksa checkbox işaretlenemez ve işaretliyse kaldırılır
                    if (esnafCheck) {
                        esnafCheck.checked = false;
                        esnafCheck.disabled = true;
                    }
                }
            }
        }

        if (individualContainer) {
            const activeIndividualSub = subs.find(s => {
                const expiresAt = s.expiresAt && s.expiresAt.toDate ? s.expiresAt.toDate() : new Date(s.expiresAt);
                return s.vitrineType === 'komsu' && expiresAt > now;
            });
            const hasActiveIndividual = !!activeIndividualSub;

            individualContainer.style.display = 'block';
            const indCheck = document.getElementById('add-is-vitrine-individual');
            const indStatus = individualContainer.querySelector('span:last-child');

            if (indCheck) {
                indCheck.disabled = !hasActiveIndividual;
                indCheck.checked = false;
            }
            if (indStatus) {
                if (hasActiveIndividual) {
                    const expiry = activeIndividualSub.expiresAt && activeIndividualSub.expiresAt.toDate ? activeIndividualSub.expiresAt.toDate() : new Date(activeIndividualSub.expiresAt);
                    indStatus.innerHTML = `Aktif paketiniz kullanılıyor. Bitiş: ${expiry.toLocaleDateString('tr-TR')}`;
                    indStatus.style.color = '#b45309';
                    individualContainer.style.opacity = '1';
                } else {
                    indStatus.innerHTML = 'Aktif vitrin paketiniz bulunmuyor. <small>(Pasif)</small>';
                    indStatus.style.color = '#ef4444';
                    individualContainer.style.opacity = '0.6';
                    // Paket yoksa checkbox işaretlenemez ve işaretliyse kaldırılır
                    if (indCheck) {
                        indCheck.checked = false;
                        indCheck.disabled = true;
                    }
                }
            }
        }
    },

    updateQuickDealVitrineOptions: function () {
        if (!this.state.user) return;

        const check = document.getElementById('quick-is-vitrine');
        const statusEl = document.getElementById('quick-vitrine-status');
        const container = document.getElementById('quick-vitrine-container');

        if (!check || !statusEl || !container) return;

        const subs = this.state.subscriptions || [];
        const now = new Date();

        const hasActiveEsnaf = subs.some(s => {
            const expiresAt = s.expiresAt && s.expiresAt.toDate ? s.expiresAt.toDate() : new Date(s.expiresAt);
            return s.vitrineType === 'esnaf' && expiresAt > now;
        });

        if (hasActiveEsnaf) {
            check.disabled = false;
            statusEl.textContent = "Esnaf Vitrini'nde yayınlar ✨";
            statusEl.style.color = "#0d9488";
            container.style.opacity = "1";
        } else {
            check.disabled = true;
            check.checked = false;
            statusEl.textContent = "Aktif Vitrin paketiniz bulunmuyor 🔒";
            statusEl.style.color = "var(--text-muted)";
            container.style.opacity = "0.7";
        }
    },

    openGalleryInfoModal: function (defaultType = 'komsu', productId = null) {
        this.contactOrigin = 'gallery';
        this.state.currentVitrineProductId = productId;
        const modal = document.getElementById('modal-gallery-info');
        if (modal) modal.style.display = 'flex';

        // Varsayılan türü seç (komsu veya esnaf)
        setTimeout(() => {
            const targetId = defaultType === 'esnaf' ? 'vitrine-esnaf' : 'vitrine-komsu';
            const el = document.getElementById(targetId);
            if (el) this.selectVitrineType(defaultType, el);
        }, 100);
    },

    closeGalleryInfoModal: function () {
        const modal = document.getElementById('modal-gallery-info');
        if (modal) modal.style.display = 'none';
        this.state.currentVitrineProductId = null;
    },

    openPazarAddModal: function () {
        if (!this.checkAuth('Pazar\'a ürün eklemek için lütfen giriş yapın.')) return;
        const modal = document.getElementById('pazar-add-modal');
        if (modal) {
            modal.style.display = 'block';
            this.renderPazarCities(); // İl listesini yükle
        }
    },

    closePazarAddModal: function () {
        const modal = document.getElementById('pazar-add-modal');
        if (modal) modal.style.display = 'none';

        // Formu temizle
        const titleEl = document.getElementById('pazar-title');
        const priceEl = document.getElementById('pazar-price');
        const descEl = document.getElementById('pazar-desc');
        const previewEl = document.getElementById('pazar-preview-img');
        const iconEl = document.querySelector('#pazar-image-picker i');
        const spanEl = document.querySelector('#pazar-image-picker span');

        if (titleEl) titleEl.value = '';
        if (priceEl) priceEl.value = '';
        if (descEl) descEl.value = '';
        if (previewEl) previewEl.style.display = 'none';
        if (iconEl) iconEl.style.display = 'block';
        if (spanEl) spanEl.style.display = 'block';

        this.state.tempPazarImage = null;
    },

    handleVitrineButtonClick: function (productId) {
        if (!this.state.user) return this.showScreen('login');

        const subs = this.state.subscriptions || [];
        const now = new Date();
        const product = this.state.products.find(p => p.id === productId);
        if (!product) return;

        // Kullanıcının tipine ve durumuna göre hedef vitrin tipini belirle
        const isEsnaf = (this.state.user.esnafStatus || '').toLowerCase() === 'approved';
        const targetType = isEsnaf ? 'esnaf' : 'komsu';

        // Aktif paket var mı?
        const activeSub = subs.find(s => {
            const expiresAt = s.expiresAt && s.expiresAt.toDate ? s.expiresAt.toDate() : new Date(s.expiresAt);
            return s.vitrineType === targetType && s.status === 'active' && expiresAt > now;
        });

        if (activeSub) {
            const expiry = activeSub.expiresAt && activeSub.expiresAt.toDate ? activeSub.expiresAt.toDate() : new Date(activeSub.expiresAt);
            if (confirm(`Aktif bir ${targetType === 'esnaf' ? 'Esnaf' : 'Bireysel'} vitrin paketiniz bulunuyor. (Bitiş: ${expiry.toLocaleDateString('tr-TR')})\n\nBu ilanı vitrine eklemek istiyor musunuz?`)) {
                this.addToVitrineDirectly(productId, targetType, activeSub);
            }
        } else {
            // Paket yoksa bilgilendirme modalını aç
            this.openGalleryInfoModal(targetType, productId);
        }
    },

    addToVitrineDirectly: async function (productId, vitrineType, sub) {
        try {
            this.toast('Vitrine ekleniyor...', 'info');

            // 1. Galeriye Ekle
            await db.collection('gallery').add({
                productId: productId,
                vitrineType: vitrineType,
                expiresAt: sub.expiresAt,
                order: 0,
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            });

            // 2. İlanı güncelle
            await db.collection('products').doc(productId).update({
                vitrine: true
            });

            // 3. Aboneliği Kullandı Olarak İşaretle (Kaldırıldı - Süre tabanlı kullanım için)
            // const updatedSubs = this.state.subscriptions.filter(s => s.id !== sub.id);
            // await db.collection('users').doc(this.state.user.uid).update({
            //     activeSubscriptions: updatedSubs
            // });

            this.toast('İlan başarıyla vitrine eklendi! ✨', 'success');
            if (this.currentScreen === 'my-ads') this.renderMyAds();
        } catch (err) {
            console.error('Add to vitrine error:', err);
            this.toast('Hata: ' + err.message, 'error');
        }
    },

    renderEsnafPanel: async function () {
        if (!this.state.user) return;
        const userId = this.state.user.uid;

        // Dükkan Ayarları Formunu Doldur
        const shopNameInput = document.getElementById('esnaf-setting-shop-name');
        const shopAddressInput = document.getElementById('esnaf-setting-shop-address');
        const shopLatInput = document.getElementById('esnaf-setting-shop-lat');
        const shopLngInput = document.getElementById('esnaf-setting-shop-lng');

        if (shopNameInput) shopNameInput.value = this.state.user.shopName || this.state.user.displayName || '';
        if (shopAddressInput) shopAddressInput.value = this.state.user.shopAddress || this.state.user.address || '';
        if (shopLatInput) shopLatInput.value = this.state.user.shopLat || (this.state.user.location ? this.state.user.location.lat : '');
        if (shopLngInput) shopLngInput.value = this.state.user.shopLng || (this.state.user.location ? this.state.user.location.lng : '');

        // İl/İlçe/Mahalle dropdown'larını başlat
        this.initEsnafLocationDropdowns();

        // İstatistikleri hesapla
        const myAds = this.state.products.filter(p => p.ownerId === userId);
        const totalViews = myAds.reduce((sum, p) => sum + (p.views || 0), 0);
        const activeOffers = this.state.offers.filter(o => myAds.some(p => p.id === o.productId) && o.status === 'pending').length;

        const viewsEl = document.getElementById('esnaf-stat-views');
        if (viewsEl) viewsEl.textContent = totalViews;

        const offersEl = document.getElementById('esnaf-stat-offers');
        if (offersEl) offersEl.textContent = activeOffers;

        // Vitrin paketlerini ve haklarını hesapla
        const vitrineSubs = (this.state.user.activeSubscriptions || []).filter(s => s.vitrineType === 'esnaf');
        const totalVitrineRights = vitrineSubs.length;
        const currentVitrineAds = myAds.filter(p => p.vitrine === true).length;

        const progress = totalVitrineRights > 0 ? (currentVitrineAds / totalVitrineRights) * 100 : 0;
        const progressBar = document.getElementById('esnaf-vitrine-progress');
        if (progressBar) progressBar.style.width = `${Math.min(progress, 100)}%`;

        const vitrineCountLabel = document.getElementById('esnaf-vitrine-count');
        if (vitrineCountLabel) {
            if (totalVitrineRights === 0) {
                vitrineCountLabel.textContent = "Aktif Paket Yok";
            } else {
                vitrineCountLabel.textContent = `${currentVitrineAds}/${totalVitrineRights} İlan Yayında`;
            }
        }

        const vitrineRemainingLabel = document.getElementById('esnaf-vitrine-remaining');
        if (vitrineRemainingLabel) {
            if (totalVitrineRights === 0) {
                vitrineRemainingLabel.textContent = "Paket Satın Alın";
            } else {
                // En yakın bitiş tarihini bul
                const now = new Date();
                const activeDates = vitrineSubs
                    .map(s => s.expiresAt && s.expiresAt.toDate ? s.expiresAt.toDate() : new Date(s.expiresAt))
                    .filter(d => d > now)
                    .sort((a, b) => a - b);

                if (activeDates.length > 0) {
                    const diff = activeDates[0] - now;
                    const days = Math.ceil(diff / (1000 * 60 * 60 * 24));
                    vitrineRemainingLabel.textContent = `En yakın bitişe ${days} gün`;
                } else {
                    vitrineRemainingLabel.textContent = "Süre Doldu";
                }
            }
        }

        // Paneldeki paket listesini güncelle
        const subList = document.getElementById('esnaf-panel-subscription-list');
        if (subList) {
            if (vitrineSubs.length === 0) {
                subList.innerHTML = '<p style="font-size: 0.8rem; color: #64748b; text-align: center; padding: 10px;">Aktif paket bulunamadı.</p>';
            } else {
                subList.innerHTML = vitrineSubs.map((s, idx) => {
                    const expiry = s.expiresAt && s.expiresAt.toDate ? s.expiresAt.toDate() : new Date(s.expiresAt);
                    const diff = expiry - new Date();
                    const daysLeft = Math.ceil(diff / (1000 * 60 * 60 * 24));

                    const title = `${s.package === 'aylık' ? 'Altın' : s.package === 'haftalık' ? 'Gümüş' : 'Standart'} Esnaf Paketi`;

                    return `
                        <div style="background: white; padding: 12px; border-radius: 12px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; gap: 10px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <span style="display: block; font-weight: 700; font-size: 0.85rem; color: #1e293b;">${title}</span>
                                    <span style="font-size: 0.7rem; color: #64748b;">Bitiş: ${expiry.toLocaleDateString('tr-TR')}</span>
                                </div>
                                <span style="font-size: 0.7rem; font-weight: 800; color: #14b8a6; background: #f0fdfa; padding: 4px 8px; border-radius: 6px; text-transform: uppercase;">
                                    ESNAF
                                </span>
                            </div>
                            
                            <!-- Canlı Geri Sayım Alanı (Screenshot'taki gibi mavi tasarım) -->
                            <div id="esnaf-sub-timer-${idx}" data-expires="${expiry.getTime()}" 
                                 style="background: #f0f9ff; border: 1px solid #e0f2fe; padding: 8px; border-radius: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; color: #0369a1; font-weight: 700; font-size: 0.85rem;">
                                <i class="fas fa-clock"></i> --:--:--
                            </div>
                        </div>
                    `;
                }).join('');

                // Zamanlayıcıları başlat
                this.startSubscriptionTimers();
            }
        }

        // --- NEW: Askıda Ürünler Sekmesini Doldur ---
        this.renderEsnafAskida();
    },

    renderEsnafAskida: async function () {
        const container = document.getElementById('esnaf-panel-askida-list');
        if (!container || !this.state.user) return;

        container.innerHTML = '<div style="text-align:center; padding:20px; color:var(--text-muted);"><i class="fas fa-spinner fa-spin"></i> Askıdaki ürünler yükleniyor...</div>';

        try {
            console.log('[Askida] Fetching for esnaf:', this.state.user.uid);
            const snapshot = await db.collection('shares')
                .where('category', '==', 'Askıda')
                .where('esnafId', '==', this.state.user.uid)
                .get();

            if (snapshot.empty) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 30px 20px; background: #f8fafc; border-radius: 18px; border: 1.5px dashed #e2e8f0;">
                        <i class="fas fa-box-open" style="font-size: 2rem; color: #cbd5e1; margin-bottom: 8px;"></i>
                        <p style="color: #64748b; font-size: 0.85rem; font-weight: 600;">Henüz ürün yok.</p>
                    </div>
                `;
                return;
            }

            // Client-side sorting (Safety check for Timestamp vs Date)
            const sortedDocs = snapshot.docs.sort((a, b) => {
                const aData = a.data();
                const bData = b.data();

                const getTime = (val) => {
                    if (!val) return 0;
                    if (typeof val.toMillis === 'function') return val.toMillis();
                    if (val instanceof Date) return val.getTime();
                    if (val.seconds) return val.seconds * 1000;
                    return 0;
                };

                return getTime(bData.createdAt) - getTime(aData.createdAt);
            });

            let html = '';
            sortedDocs.forEach(doc => {
                const data = doc.data();
                const id = doc.id;
                const status = data.status || 'available';
                const timeStr = ''; // Hatalı fonksiyon çağrısı kaldırıldı

                html += `
                    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 12px; position: relative; margin-bottom: 8px;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                            <div style="flex: 1;">
                                <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
                                    <span style="font-size: 0.65rem; color: var(--primary); font-weight: 800; background: #f0fdfa; padding: 2px 8px; border-radius: 6px;">${data.claimCode || 'KODSUZ'}</span>
                                    <span style="font-size: 0.65rem; font-weight: 700; color: ${status === 'delivered' ? '#10b981' : (status === 'reserved' ? '#f59e0b' : '#3b82f6')}; background: ${status === 'delivered' ? '#ecfdf5' : (status === 'reserved' ? '#fffbeb' : '#eff6ff')}; padding: 2px 8px; border-radius: 6px;">
                                        ${status === 'delivered' ? 'Teslim Edildi' : (status === 'reserved' ? 'Rezerve' : 'Askıda')}
                                    </span>
                                </div>
                                <h4 style="font-size: 0.9rem; font-weight: 800; color: #1e293b; margin: 0;">${this.utils.escapeHTML(data.content)}</h4>
                                <p style="font-size: 0.7rem; color: #64748b; margin-top: 2px;">Bırakan: <b>${this.utils.escapeHTML(data.userName)}</b></p>
                            </div>
                        </div>

                        <div style="display: flex; gap: 6px; margin-top: 8px;">
                            <button onclick="app.callUser('${data.ownerPhone}')" 
                                    style="flex: 1; height: 32px; background: #eff6ff; border: none; color: #3b82f6; border-radius: 8px; font-weight: 700; font-size: 0.7rem; display: flex; align-items: center; justify-content: center; gap: 4px; cursor: pointer;">
                                <i class="fas fa-phone"></i> Bağışçı
                            </button>
                            ${data.buyerPhone ? `
                                <button onclick="app.whatsappUser('${data.buyerPhone}', 'Askıda Ürün Hakkında: ${this.utils.escapeHTML(data.content)}')" 
                                        style="flex: 1; height: 32px; background: #ecfdf5; border: none; color: #10b981; border-radius: 8px; font-weight: 700; font-size: 0.7rem; display: flex; align-items: center; justify-content: center; gap: 4px; cursor: pointer;">
                                    <i class="fab fa-whatsapp"></i> Alıcı
                                </button>
                            ` : ''}
                            <button onclick="app.updateAskidaStatus('${id}', '${status === 'available' ? 'delivered' : 'available'}')" 
                                    style="height: 32px; width: 32px; background: #f1f5f9; border: none; color: #475569; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer;" title="Durumu Değiştir">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        } catch (e) {
            console.error('renderEsnafAskida error:', e);
            container.innerHTML = `<div style="text-align:center; padding:10px; color:#ef4444; font-size:0.75rem;">Yükleme Hatası: ${e.message}</div>`;
        }
    },

    updateAskidaStatus: async function (docId, newStatus) {
        try {
            this.toast('Güncelleniyor...');
            await db.collection('shares').doc(docId).update({ status: newStatus });
            this.toast('Durum güncellendi! ✨');
            this.renderEsnafAskida();
        } catch (e) {
            console.error(e);
            this.toast('Hata oluştu: ' + e.message, 'error');
        }
    },

    callUser: function (phone) {
        if (!phone) return this.toast('Telefon numarası bulunamadı.', 'warning');
        window.location.href = 'tel:' + phone;
    },

    whatsappUser: function (phone, message) {
        if (!phone) return this.toast('Telefon numarası bulunamadı.', 'warning');
        const cleanPhone = phone.replace(/\D/g, '');
        const formattedPhone = cleanPhone.startsWith('90') ? cleanPhone : '90' + cleanPhone;
        const url = `https://wa.me/${formattedPhone}?text=${encodeURIComponent(message)}`;
        window.open(url, '_blank');
    },

    togglePanelSection: function (sectionId) {
        const content = document.getElementById('panel-content-' + sectionId);
        const icon = document.getElementById('panel-icon-' + sectionId);
        if (!content || !icon) return;

        const isHidden = content.style.display === 'none';
        content.style.display = isHidden ? 'block' : 'none';

        // İkonu güncelle
        if (isHidden) {
            icon.classList.remove('fa-chevron-down');
            icon.classList.add('fa-chevron-up');
        } else {
            icon.classList.remove('fa-chevron-up');
            icon.classList.add('fa-chevron-down');
        }
    },

    saveEsnafSettings: async function () {
        if (!this.state.user) return;
        const btn = document.getElementById('btn-save-esnaf-settings');
        const shopName = document.getElementById('esnaf-setting-shop-name').value.trim();
        const shopAddress = document.getElementById('esnaf-setting-shop-address').value.trim();
        const shopLat = parseFloat(document.getElementById('esnaf-setting-shop-lat').value);
        const shopLng = parseFloat(document.getElementById('esnaf-setting-shop-lng').value);

        // İl/İlçe/Mahalle bilgilerini al
        const citySelect = document.getElementById('esnaf-setting-city');
        const districtSelect = document.getElementById('esnaf-setting-district');
        const neighborhoodSelect = document.getElementById('esnaf-setting-neighborhood');

        const shopCity = citySelect ? citySelect.options[citySelect.selectedIndex]?.text : '';
        const shopDistrict = districtSelect ? districtSelect.options[districtSelect.selectedIndex]?.text : '';
        const shopNeighborhood = neighborhoodSelect ? neighborhoodSelect.value : '';

        const shopCityId = citySelect ? citySelect.value : null;
        const shopDistrictId = districtSelect ? districtSelect.value : null;

        if (!shopName) return this.toast('Dükkan adı boş olamaz.', 'error');

        try {
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...';
            }

            await db.collection('users').doc(this.state.user.uid).update({
                shopName: shopName,
                shopAddress: shopAddress,
                shopLat: shopLat || null,
                shopLng: shopLng || null,
                shopCity: shopCity && shopCity !== 'İl Seçin' ? shopCity : null,
                shopCityId: shopCityId || null,
                shopDistrict: shopDistrict && shopDistrict !== 'İlçe Seçin' ? shopDistrict : null,
                shopDistrictId: shopDistrictId || null,
                shopNeighborhood: shopNeighborhood || null,
                // Ana profille de senkronize et
                displayName: shopName,
                address: shopAddress,
                city: shopCity && shopCity !== 'İl Seçin' ? shopCity : null,
                cityId: shopCityId || null,
                district: shopDistrict && shopDistrict !== 'İlçe Seçin' ? shopDistrict : null,
                districtId: shopDistrictId || null,
                neighborhood: shopNeighborhood || null
            });

            this.toast('Dükkan ayarları başarıyla güncellendi! ✨', 'success');

            // Yerel state'i güncelle
            if (this.state.user) {
                this.state.user.shopName = shopName;
                this.state.user.shopAddress = shopAddress;
                this.state.user.shopCityId = shopCityId;
                this.state.user.shopDistrictId = shopDistrictId;
                this.state.user.shopCity = shopCity;
                this.state.user.shopDistrict = shopDistrict;
                this.state.user.shopNeighborhood = shopNeighborhood;
            }

        } catch (err) {
            console.error('Save esnaf settings error:', err);
            this.toast('Ayarlar kaydedilirken bir hata oluştu.', 'error');
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = 'Ayarları Kaydet';
            }
        }
    },

    // Esnaf paneli için il/ilçe/mahalle handler'ları
    handleEsnafCityChange: async function () {
        const provinceId = document.getElementById('esnaf-setting-city').value;
        const districtSelect = document.getElementById('esnaf-setting-district');
        const neighborhoodSelect = document.getElementById('esnaf-setting-neighborhood');
        if (!districtSelect) return;

        districtSelect.innerHTML = '<option value="">Yükleniyor...</option>';
        neighborhoodSelect.innerHTML = '<option value="">Mahalle Seçin</option>';

        if (provinceId === "") {
            districtSelect.innerHTML = '<option value="">İlçe Seçin</option>';
            return;
        }

        try {
            const resp = await fetch(`https://turkiyeapi.dev/api/v1/provinces/${provinceId}`);
            if (!resp.ok) throw new Error('İlçe verisi alınamadı');
            const result = await resp.json();
            const districts = result.data.districts || [];

            let html = '<option value="">İlçe Seçin</option>';
            districts.forEach(dist => {
                html += `<option value="${dist.id}">${dist.name}</option>`;
            });
            districtSelect.innerHTML = html;
        } catch (e) {
            console.error('Esnaf district fetch error:', e);
            districtSelect.innerHTML = '<option value="">İlçe yüklenemedi</option>';
        }
    },

    handleEsnafDistrictChange: async function () {
        const districtId = document.getElementById('esnaf-setting-district').value;
        const neighborhoodSelect = document.getElementById('esnaf-setting-neighborhood');
        if (!neighborhoodSelect) return;

        neighborhoodSelect.innerHTML = '<option value="">Yükleniyor...</option>';

        if (districtId === "") {
            neighborhoodSelect.innerHTML = '<option value="">Mahalle Seçin</option>';
            return;
        }

        try {
            const resp = await fetch(`https://turkiyeapi.dev/api/v1/districts/${districtId}`);
            if (!resp.ok) throw new Error('Mahalle verisi alınamadı: ' + resp.status);
            const result = await resp.json();

            const districtData = Array.isArray(result.data) ? result.data[0] : result.data;
            const neighborhoods = districtData.neighborhoods || [];
            const villages = districtData.villages || [];

            const allLocations = [...neighborhoods, ...villages];
            allLocations.sort((a, b) => a.name.localeCompare(b.name, 'tr'));

            let html = '<option value="">Mahalle Seçin</option>';
            allLocations.forEach(loc => {
                html += `<option value="${loc.name}">${loc.name}</option>`;
            });
            neighborhoodSelect.innerHTML = html;
        } catch (e) {
            console.error('Esnaf neighborhood fetch error for district ' + districtId + ':', e);
            neighborhoodSelect.innerHTML = '<option value="">Mahalle yüklenemedi</option>';
            this.toast('Mahalleler yüklenirken bir hata oluştu.', 'error');
        }
    },

    // Esnaf paneli dropdown'larını başlangıçta doldur
    initEsnafLocationDropdowns: async function () {
        const citySelect = document.getElementById('esnaf-setting-city');
        if (!citySelect) return;

        try {
            const resp = await fetch('https://turkiyeapi.dev/api/v1/provinces');
            if (!resp.ok) throw new Error('İl verisi alınamadı');
            const result = await resp.json();
            const provinces = result.data || [];

            let html = '<option value="">İl Seçin</option>';
            provinces.forEach(p => {
                html += `<option value="${p.id}">${p.name}</option>`;
            });
            citySelect.innerHTML = html;

            // Eğer kullanıcının kayıtlı şehri varsa seç
            if (this.state.user && this.state.user.shopCity) {
                const savedCity = this.state.user.shopCity;
                const matchingProvince = provinces.find(p => p.name === savedCity);
                if (matchingProvince) {
                    citySelect.value = matchingProvince.id;
                    await this.handleEsnafCityChange();

                    // İlçeyi seç
                    if (this.state.user.shopDistrict) {
                        const districtSelect = document.getElementById('esnaf-setting-district');
                        if (districtSelect) {
                            for (let option of districtSelect.options) {
                                if (option.text === this.state.user.shopDistrict) {
                                    districtSelect.value = option.value;
                                    await this.handleEsnafDistrictChange();
                                    break;
                                }
                            }
                        }
                    }

                    // Mahalleyi seç
                    if (this.state.user.shopNeighborhood) {
                        const neighborhoodSelect = document.getElementById('esnaf-setting-neighborhood');
                        if (neighborhoodSelect) {
                            neighborhoodSelect.value = this.state.user.shopNeighborhood;
                        }
                    }
                }
            }
        } catch (e) {
            console.error('Esnaf provinces fetch error:', e);
        }
    },

    getShopLocation: function () {
        if (!navigator.geolocation) {
            return this.toast('Tarayıcınız konum özelliğini desteklemiyor.', 'warning');
        }

        const btn = event.currentTarget;
        const oldHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Konum alınıyor...';

        navigator.geolocation.getCurrentPosition(
            (pos) => {
                const latInput = document.getElementById('esnaf-setting-shop-lat');
                const lngInput = document.getElementById('esnaf-setting-shop-lng');
                if (latInput) latInput.value = pos.coords.latitude.toFixed(6);
                if (lngInput) lngInput.value = pos.coords.longitude.toFixed(6);
                this.toast('Konumunuz başarıyla alındı! 📍', 'success');
                btn.disabled = false;
                btn.innerHTML = oldHtml;
            },
            (err) => {
                console.error('Geolocation error:', err);
                this.toast('Konum alınamadı. Lütfen izin verdiğinizden emin olun.', 'error');
                btn.disabled = false;
                btn.innerHTML = oldHtml;
            },
            { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
        );
    },

    showPublicStore: function () {
        if (!this.state.user) return;
        this.showScreen('my-ads');
    },

    // --- Live Map (Radar) Logic ---
    initLiveMap: function () {
        const mapContainer = document.getElementById('live-map');
        if (!mapContainer) return;

        // Harita zaten yüklüyse tekrar yükleme
        if (this.liveMapInstance) {
            setTimeout(() => this.liveMapInstance.invalidateSize(), 100);
            return;
        }

        // Harita kütüphanesinin yüklü olduğundan emin ol
        if (typeof L.markerClusterGroup !== 'function') {
            console.error("Leaflet.markercluster kütüphanesi yüklenemedi. İlanlar gruplanmadan gösterilecek.");
            this.renderMapMarkersLegacy();
            return;
        }

        const userLoc = (this.state.user && this.state.user.location) ? this.state.user.location : { lat: 41.0082, lng: 28.9784 };
        this.liveMapInstance = L.map('live-map').setView([userLoc.lat, userLoc.lng], 14);

        const isDarkMode = document.documentElement.classList.contains('dark-mode');
        const tileUrl = isDarkMode
            ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
            : 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';

        const attribution = isDarkMode
            ? '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
            : '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors';

        L.tileLayer(tileUrl, { attribution }).addTo(this.liveMapInstance);

        // İlanları haritaya bas
        if (this.liveMapMarkersCluster) {
            this.liveMapInstance.removeLayer(this.liveMapMarkersCluster);
        }
        this.liveMapMarkersCluster = L.markerClusterGroup({
            showCoverageOnHover: false,
            spiderfyOnMaxZoom: true,
            zoomToBoundsOnClick: true,
            maxClusterRadius: 40 // Biraz daha sıkı gruplama
        });

        this.renderMapMarkers();
        this.liveMapInstance.addLayer(this.liveMapMarkersCluster);
    },

    renderMapMarkers: function () {
        if (!this.liveMapInstance || !this.liveMapMarkersCluster) return;

        // Eski markerları (Safe Points vb) haritadan temizle
        if (this.liveMapMarkers) {
            this.liveMapMarkers.forEach(m => this.liveMapInstance.removeLayer(m));
        }
        this.liveMapMarkers = [];

        // Cluster içeriğini temizle
        this.liveMapMarkersCluster.clearLayers();

        this.state.products.forEach(p => {
            // Güvenlik: Satılmış veya süresi dolmuş ilanları haritada gösterme
            const isSold = p.status === 'sold' || this.state.offers.some(o => o.productId === p.id && o.status === 'accepted');
            const isExpired = this.utils.isProductExpired(p);
            if (isSold || isExpired) return;

            // Güvenli konum okuma (Optional chaining ve fallback)
            const lat = p.lat || p.location?.lat;
            const lng = p.lng || p.location?.lng;

            if (lat && lng) {
                const customIcon = L.divIcon({
                    html: `
                    <div style="position: relative; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-location-dot" style="font-size: 2.2rem; color: var(--primary); filter: drop-shadow(0 2px 5px rgba(0,0,0,0.2));"></i>
                        <div style="position: absolute; top: 12px; width: 7px; height: 7px; background: white; border-radius: 50%; box-shadow: inset 0 1px 2px rgba(0,0,0,0.2);"></div>
                    </div>
                `,
                    className: 'custom-ad-marker',
                    iconSize: [32, 32],
                    iconAnchor: [16, 32],
                    popupAnchor: [0, -32]
                });

                const marker = L.marker([lat, lng], { icon: customIcon });

                const productImg = p.image || (p.images && p.images.length > 0 ? p.images[0] : 'https://via.placeholder.com/150?text=Görsel+Yok');

                marker.bindPopup(`
            <div style="font-family: inherit; padding: 5px; min-width: 160px;">
                <div style="width: 100%; height: 110px; overflow: hidden; border-radius: 12px; margin-bottom: 10px; background: var(--bg-card);">
                    <img src="${productImg}" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
                <h4 style="margin: 0; font-size: 1rem; font-weight: 800; color: var(--text-main); line-height: 1.2;">${p.title}</h4>
                <p style="margin: 6px 0 12px; font-size: 0.9rem; font-weight: 800; color: var(--primary);">${p.isFree ? 'ÜCRETSİZ 🌱' : p.price + ' TL'}</p>
                <button onclick="app.showProductDetails('${p.id}')" 
                        style="width: 100%; background: var(--primary); color: white; border: none; border-radius: 12px; padding: 10px; font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 10px rgba(0, 168, 150, 0.2);">
                    İncele
                </button>
            </div>
        `);
                this.liveMapMarkersCluster.addLayer(marker);
            }
        });

        // Güvenli Noktaları Haritaya Bas
        this.renderSafePointsOnMap();
    },

    renderMapMarkersLegacy: function () {
        if (!this.liveMapInstance) return;

        if (this.liveMapMarkers) {
            this.liveMapMarkers.forEach(m => this.liveMapInstance.removeLayer(m));
        }
        this.liveMapMarkers = [];

        this.state.products.forEach(p => {
            // Güvenlik: Satılmış veya süresi dolmuş ilanları haritada gösterme
            const isSold = p.status === 'sold' || this.state.offers.some(o => o.productId === p.id && o.status === 'accepted');
            const isExpired = this.utils.isProductExpired(p);
            if (isSold || isExpired) return;

            const lat = p.lat || p.location?.lat;
            const lng = p.lng || p.location?.lng;

            if (lat && lng) {
                const customIcon = L.divIcon({
                    html: `
                    <div style="position: relative; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-location-dot" style="font-size: 2.2rem; color: var(--primary); filter: drop-shadow(0 2px 5px rgba(0,0,0,0.2));"></i>
                        <div style="position: absolute; top: 12px; width: 7px; height: 7px; background: white; border-radius: 50%; box-shadow: inset 0 1px 2px rgba(0,0,0,0.2);"></div>
                    </div>
                `,
                    className: 'custom-ad-marker',
                    iconSize: [32, 32],
                    iconAnchor: [16, 32],
                    popupAnchor: [0, -32]
                });

                const marker = L.marker([lat, lng], { icon: customIcon }).addTo(this.liveMapInstance);

                const productImg = p.image || (p.images && p.images.length > 0 ? p.images[0] : 'https://via.placeholder.com/150?text=Görsel+Yok');

                marker.bindPopup(`
            <div style="font-family: inherit; padding: 5px; min-width: 160px;">
                <div style="width: 100%; height: 110px; overflow: hidden; border-radius: 12px; margin-bottom: 10px; background: var(--bg-card);">
                    <img src="${productImg}" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
                <h4 style="margin: 0; font-size: 1rem; font-weight: 800; color: var(--text-main); line-height: 1.2;">${p.title}</h4>
                <p style="margin: 6px 0 12px; font-size: 0.9rem; font-weight: 800; color: var(--primary);">${p.isFree ? 'ÜCRETSİZ 🌱' : p.price + ' TL'}</p>
                <button onclick="app.showProductDetails('${p.id}')" 
                        style="width: 100%; background: var(--primary); color: white; border: none; border-radius: 12px; padding: 10px; font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 10px rgba(0, 168, 150, 0.2);">
                    İncele
                </button>
            </div>
        `);
                this.liveMapMarkers.push(marker);
            }
        });

        // Güvenli Noktaları Haritaya Bas
        this.renderSafePointsOnMap();
    },

    renderSafePointsOnMap: function () {
        if (!this.liveMapInstance) return;

        this.state.safePoints.forEach(sp => {
            const lat = sp.lat;
            const lng = sp.lng;

            if (lat && lng) {
                const isPartner = sp.isPartner === true;
                const markerColor = isPartner ? '#FFD700' : '#4CAF50'; // Partner: Altın Sarısı, Normal: Yeşil
                const iconClass = isPartner ? 'fa-star' : 'fa-shield-halved';

                const safeIcon = L.divIcon({
                    html: `
                    <div style="position: relative; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-location-dot" style="font-size: 2.2rem; color: ${markerColor}; filter: drop-shadow(0 2px 5px rgba(0,0,0,0.3));"></i>
                        <div style="position: absolute; top: 10px; width: 14px; height: 14px; display: flex; align-items: center; justify-content: center; color: white;">
                            <i class="fas ${iconClass}" style="font-size: 0.6rem;"></i>
                        </div>
                    </div>
                `,
                    className: 'safe-point-marker',
                    iconSize: [32, 32],
                    iconAnchor: [16, 32],
                    popupAnchor: [0, -32]
                });

                const marker = L.marker([lat, lng], { icon: safeIcon }).addTo(this.liveMapInstance);

                marker.bindPopup(`
                    <div style="font-family: inherit; padding: 8px; min-width: 180px; text-align: center;">
                        <div style="font-size: 0.7rem; font-weight: 800; color: ${markerColor}; text-transform: uppercase; margin-bottom: 4px;">
                            ${isPartner ? '⭐ PARTNER GÜVENLİ NOKTA' : '🛡️ GÜVENLİ BULUŞMA NOKTASI'}
                        </div>
                        <h4 style="margin: 0 0 8px; font-size: 1rem; font-weight: 800; color: var(--text-main);">${this.utils.escapeHTML(sp.name)}</h4>
                        <p style="margin: 0 0 12px; font-size: 0.8rem; color: var(--text-muted);">${this.utils.escapeHTML(sp.address || 'Güvende buluşun ve alışveriş yapın.')}</p>
                        <div style="font-size: 0.75rem; background: #f8f9fa; padding: 8px; border-radius: 8px; border: 1px dashed ${markerColor}; color: #555;">
                            ${isPartner ? 'Bu işletme Yanımdaki resmi partneridir. Güvenle alışveriş yapabilirsiniz.' : 'Halka açık, güvenli bir buluşma alanıdır.'}
                        </div>
                    </div>
                `);
                this.liveMapMarkers.push(marker);
            }
        });
    },

    // --- Share (Mahalle Akışı) Logic ---
    renderShareFeed: async function () {
        const feedEl = document.getElementById('share-feed');
        if (!feedEl) return;

        try {
            // Fetch needs board once
            this.renderNeighborhoodNeeds();
            this.renderAskidaEsnafVitrin();
            this.loadLocationData();
            this.renderShareFilterCities();

            const snapshot = await db.collection('shares').orderBy('createdAt', 'desc').get();
            this.state.currentShares = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));

            // --- Lazy Cleanup: Delete shares older than 24h ---
            const now = new Date();
            const expiredIds = this.state.currentShares
                .filter(data => {
                    const created = data.createdAt ? new Date(data.createdAt.seconds * 1000) : new Date();
                    const expiresAt = new Date(created.getTime() + 24 * 60 * 60 * 1000);
                    return expiresAt < now;
                })
                .map(s => s.id);

            if (expiredIds.length > 0) {
                expiredIds.forEach(id => this.deleteShare(id, true));
                // Remove from state immediately for UI consistency
                this.state.currentShares = this.state.currentShares.filter(s => !expiredIds.includes(s.id));
            }
            // ------------------------------------------------

            if (this.state.currentShares.length === 0) {
                feedEl.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-heart" style="font-size: 3rem; color: #ffebef; margin-bottom: 16px;"></i>
                        <p>Henüz mahallenizde bir paylaşım yok. İlk adımı siz atın!</p>
                    </div>`;
                return;
            }

            this.applyShareFilters();
        } catch (e) {
            console.error(e);
            this.toast('Akış yüklenemedi.', 'error');
        }

        this.injectAdsenseCode();
    },

    injectAdsenseCode: function () {
        const container = document.getElementById('adsense-container');
        if (!container) return;

        if (!this.state.adsenseCode || this.state.adsenseCode.trim() === '') {
            container.style.display = 'none';
            return;
        }

        // Eğer kod zaten enjekte edilmişse ve değişmemişse tekrar yapma (sonsuz döngü/titremeyi önlemek için)
        const currentCodeHash = btoa(unescape(encodeURIComponent(this.state.adsenseCode)));
        if (container.getAttribute('data-last-code') === currentCodeHash) {
            container.style.display = 'block';
            return;
        }

        try {
            container.innerHTML = this.state.adsenseCode;

            // Script taglarını manuel olarak çalıştır (AdSense için gerekli)
            const scripts = container.querySelectorAll('script');
            scripts.forEach(oldScript => {
                const newScript = document.createElement('script');
                Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                if (oldScript.innerHTML) {
                    newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                }
                oldScript.parentNode.replaceChild(newScript, oldScript);
            });

            container.setAttribute('data-last-code', currentCodeHash);
            container.style.display = 'block';
        } catch (e) {
            console.error('AdSense injection error:', e);
            container.style.display = 'none';
        }
    },

    applyShareFilters: function () {
        const feedEl = document.getElementById('share-feed');
        if (!feedEl || !this.state.currentShares) return;

        let filtered = this.state.currentShares;
        const now = new Date();

        // 1. Expiry Check (24h)
        filtered = filtered.filter(data => {
            const created = data.createdAt ? new Date(data.createdAt.seconds * 1000) : new Date();
            const expiresAt = new Date(created.getTime() + 24 * 60 * 60 * 1000);
            return expiresAt > now;
        });

        // 2. Filter by Category
        if (this.state.shareCategoryFilter) {
            filtered = filtered.filter(s => s.category === this.state.shareCategoryFilter || s.type === this.state.shareCategoryFilter);
        }

        // 2.5 Filter by Search Query
        if (this.state.shareSearchQuery && this.state.shareSearchQuery.trim() !== '') {
            const query = this.state.shareSearchQuery.toLowerCase();
            filtered = filtered.filter(s =>
                (s.content && s.content.toLowerCase().includes(query)) ||
                (s.userName && s.userName.toLowerCase().includes(query)) ||
                (s.city && s.city.toLowerCase().includes(query)) ||
                (s.district && s.district.toLowerCase().includes(query)) ||
                (s.neighborhood && s.neighborhood.toLowerCase().includes(query))
            );
        }

        // 3. Filter by Location (City, District, Neighborhood)
        if (this.state.filters.shareCity !== 'all') {
            const cityEl = document.getElementById('share-filter-city');
            const cityName = cityEl ? cityEl.options[cityEl.selectedIndex].text : '';
            filtered = filtered.filter(s =>
                (s.cityId && s.cityId == this.state.filters.shareCity) ||
                (s.city && s.city === cityName)
            );
        }
        if (this.state.filters.shareDistrict !== 'all') {
            const distEl = document.getElementById('share-filter-district');
            const distName = distEl ? distEl.options[distEl.selectedIndex].text : '';
            filtered = filtered.filter(s =>
                (s.districtId && s.districtId == this.state.filters.shareDistrict) ||
                (s.district && s.district === distName)
            );
        }
        if (this.state.filters.shareNeighborhood !== 'all') {
            filtered = filtered.filter(s => s.neighborhood === this.state.filters.shareNeighborhood);
        }

        // 4. Filter by Type
        if (this.state.shareFilter === 'urgent') {
            filtered = filtered.filter(s => s.isUrgent);
        } else if (this.state.shareFilter === 'favorites') {
            filtered = filtered.filter(s => s.savedBy && s.savedBy.includes(this.state.user.uid));
        } else if (this.state.shareFilter === 'nearby') {
            const uLat = (this.state.user && this.state.user.location) ? this.state.user.location.lat : 41.0082;
            const uLng = (this.state.user && this.state.user.location) ? this.state.user.location.lng : 28.9784;
            filtered = filtered.filter(s => {
                const dist = this.utils.calculateDistance(
                    uLat,
                    uLng,
                    s.lat || 0,
                    s.lng || 0
                );
                return dist <= 10; // 10km limit for "nearby"
            });
        } else if (this.state.shareFilter === 'suggested') {
            const uUid = this.state.user ? this.state.user.uid : null;
            const uLat = (this.state.user && this.state.user.location) ? this.state.user.location.lat : 41.0082;
            const uLng = (this.state.user && this.state.user.location) ? this.state.user.location.lng : 28.9784;
            filtered = filtered.filter(s => {
                if (s.userId === uUid) return false;
                const dist = this.utils.calculateDistance(
                    uLat,
                    uLng,
                    s.lat || 0,
                    s.lng || 0
                );
                // Suggested: within 2km OR has 5+ thanks
                return dist <= 2 || (s.thanks && s.thanks >= 5);
            });
        }

        // 4. Default Fallback for Nearby: If nearby is empty, show all but sorted by distance
        if (this.state.shareFilter === 'nearby' && filtered.length === 0 && this.state.currentShares.length > 0) {
            filtered = [...this.state.currentShares];
            // No more filtering, just sorting by distance (already done implicitly by showing all, but let's be explicit if needed)
        }

        if (filtered.length === 0) {
            feedEl.innerHTML = '<div class="empty-state"><p>Bu filtreye uygun paylaşım bulunamadı.</p></div>';
            return;
        }

        let html = '<div class="share-posts">';
        filtered.forEach(data => {
            const created = data.createdAt ? new Date(data.createdAt.seconds * 1000) : new Date();
            const uLat = (this.state.user && this.state.user.location) ? this.state.user.location.lat : 41.0082;
            const uLng = (this.state.user && this.state.user.location) ? this.state.user.location.lng : 28.9784;
            const dist = this.utils.calculateDistance(
                uLat,
                uLng,
                data.lat || 0,
                data.lng || 0
            );

            const time = created.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            let tagClass = `tag-${data.type || 'paylas'}`;
            let tagLabel = data.type === 'paylas' ? 'PAYLAŞIYOR' : (data.type === 'ihtiyac' ? 'ARAŞTIRIYOR' : 'TAKAS EDİYOR');
            if (data.isUrgent) {
                tagClass = 'tag-urgent';
                tagLabel = '🔴 ACİL İHTİYAÇ';
            }

            if (data.category === 'Askıda') {
                tagClass = 'tag-askida';
                tagLabel = '🧺 ASKIDA';
            }

            const isSaved = data.savedBy && data.savedBy.includes(this.state.user.uid);
            const thanksCount = data.thanks || 0;

            // Countdown Calculation (24h)
            const expiresAt = new Date(created.getTime() + 24 * 60 * 60 * 1000);
            const diffMs = expiresAt - now;
            const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
            const diffMins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

            let timeLeftStr = diffHours > 0 ? `Son ${diffHours} saat` : `Son ${diffMins} dakika`;
            if (diffMs < 0) timeLeftStr = "Süresi doldu";

            html += `
                <div class="share-card ${data.isUrgent ? 'urgent-border' : ''}">
                    <div class="share-card-header">
                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                            <span class="share-tag ${tagClass}">${tagLabel}</span>
                            ${data.category ? `<span class="share-tag tag-category">${data.category}</span>` : ''}
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="share-countdown"><i class="fas fa-hourglass-half"></i> ${timeLeftStr}</span>
                            ${(data.userId === this.state.user.uid) ? `
                                <div onclick="app.deleteShare('${data.id}')" style="color: #ef4444; cursor: pointer; font-size: 0.8rem; opacity: 0.6;">
                                    <i class="fas fa-trash"></i>
                                </div>
                            ` : ''}
                        </div>
                    </div>
                    
                    <div class="share-body">
                        ${(data.category === 'Askıda') ? `
                            <div onclick="app.showSellerProfile('${data.esnafId}')" style="background: rgba(245, 158, 11, 0.1); padding: 12px; border-radius: 12px; border: 1px dashed #f59e0b; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                <i class="fas fa-store" style="color: #f59e0b; font-size: 1.2rem;"></i>
                                <div>
                                    <div style="font-size: 0.75rem; color: #b45309; font-weight: 800; text-transform: uppercase;">Teslim Noktası</div>
                                    <div style="font-weight: 800; color: var(--text-main);">${this.utils.escapeHTML(data.esnafName || 'Mahalle Esnafı')}</div>
                                </div>
                            </div>
                        ` : ''}
                        ${(data.title && data.title !== data.content && !data.content.startsWith(data.title.replace('...', ''))) ? `
                            <div style="font-weight: 800; font-size: 1.05rem; margin-bottom: 6px; color: var(--text-main);">
                                ${this.utils.escapeHTML(data.title)}
                            </div>
                        ` : ''}
                        <p style="font-size: 0.9rem; color: var(--text-main); line-height: 1.5; font-weight: 700">
                            ${this.utils.escapeHTML(data.content)}
                        </p>
                        ${(data.category === 'Askıda' && data.status === 'reserved') ? `
                            <div style="margin-top: 10px; background: #f1f5f9; color: #475569; padding: 8px 12px; border-radius: 8px; font-size: 0.8rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
                                <i class="fas fa-handshake"></i> Rezerve Edildi
                            </div>
                            
                            ${(this.state.user.uid === data.reservedBy || this.state.user.uid === data.esnafId) ? `
                                <div style="margin-top: 10px; background: var(--secondary); border: 2px dashed var(--primary); padding: 10px; border-radius: 12px; text-align: center;">
                                    <div style="font-size: 0.65rem; font-weight: 800; color: var(--primary); margin-bottom: 2px;">ALIM KODU</div>
                                    <div style="font-size: 1.5rem; font-weight: 900; letter-spacing: 2px; color: var(--text-main);">${data.claimCode || '----'}</div>
                                    <div style="font-size: 0.6rem; color: var(--text-muted); margin-top: 2px;">${this.state.user.uid === data.esnafId ? 'Bu kodu rezervasyon sahibinden isteyin' : 'Bu kodu esnafa gösterin'}</div>
                                </div>
                            ` : ''}
                        ` : ''}
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 4px; margin: 12px 0;">
                        <div style="display: flex; align-items: center; gap: 12px; font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">
                            <span><i class="fas fa-location-dot"></i> ${this.utils.formatDistance(dist)}</span>
                            <span><i class="fas fa-clock"></i> Bugün, ${time}</span>
                        </div>
                        ${(data.city || data.locationText) ? `
                            <div style="font-size: 0.75rem; color: var(--primary); font-weight: 700; display: flex; align-items: center; gap: 4px;">
                                <i class="fas fa-map-pin"></i> ${data.neighborhood ? data.neighborhood + ', ' : ''}${data.district ? data.district + ', ' : ''}${data.city || ''}
                            </div>
                        ` : ''}
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border-color);">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div class="share-user-avatar">
                                <i class="fas fa-user"></i>
                            </div>
                            <div style="display: flex; flex-direction: column;">
                                <span class="share-username">${this.utils.escapeHTML(data.userName || 'Komşu')}</span>
                                <span style="font-size: 0.65rem; color: var(--primary); font-weight: 700;">🌟 ${thanksCount} teşekkür</span>
                            </div>
                        </div>
                        
                        <div style="display: flex; gap: 8px;">
                            ${(data.userId !== this.state.user.uid) ? `
                                ${(data.category === 'Askıda') ? `
                                    ${(data.status === 'available') ? `
                                        <button onclick="app.reserveAskida('${data.id}')" class="filter-chip active" style="padding: 6px 16px; border-radius: 12px; background: #f59e0b; color: white; border-color: #f59e0b;">
                                            <i class="fas fa-hand-holding-heart"></i> İhtiyacım Var
                                        </button>
                                    ` : `
                                        <button class="filter-chip" style="padding: 6px 16px; border-radius: 12px; opacity: 0.5; cursor: not-allowed;" disabled>
                                            <i class="fas fa-lock"></i> Rezerve Edildi
                                        </button>
                                    `}
                                ` : `
                                    <button onclick="app.thankShare('${data.id}')" class="filter-chip" style="padding: 6px 12px; border-radius: 12px;">
                                        <i class="fas fa-heart" style="color: #ef4444;"></i> Teşekkür
                                    </button>
                                    <button onclick="app.openChat(null, '${data.ownerPhone}', '${this.utils.escapeHTML(data.userName)}')" class="filter-chip active" style="padding: 6px 12px; border-radius: 12px;">
                                        <i class="fas fa-comment"></i> Mesaj
                                    </button>
                                `}
                            ` : ''}
                            <button onclick="app.saveShare('${data.id}', ${!isSaved})" class="filter-chip" style="padding: 6px 12px; border-radius: 12px; border: 1px solid ${isSaved ? 'var(--primary)' : 'var(--border-color)'};">
                                <i class="${isSaved ? 'fas' : 'far'} fa-bookmark" style="color: ${isSaved ? 'var(--primary)' : 'inherit'};"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        });
        html += '</div>';
        feedEl.innerHTML = html;
    },

    setShareFilter: function (filter, el) {
        this.state.shareFilter = filter;
        this.state.shareCategoryFilter = null; // Clear category filter when type filter is clicked
        document.querySelectorAll('.share-filter-scroll .filter-chip').forEach(c => c.classList.remove('active'));
        if (el) el.classList.add('active');
        this.applyShareFilters();
    },

    toggleShareCategorySelect: function () {
        const categories = ['Eşya', 'Ödünç', 'Hizmet', 'Duyuru', 'Eğitim', 'Askıda', 'Diğer'];
        const current = this.state.shareCategoryFilter || 'Kategori';

        let options = categories.map(cat =>
            `<div onclick="app.setShareCategoryFilter('${cat}')" class="category-option ${cat === current ? 'active' : ''}">${cat}</div>`
        ).join('');

        // Clear filter option
        options = `<div onclick="app.setShareCategoryFilter(null)" class="category-option text-danger">Filtreyi Temizle</div>` + options;

        const modalHtml = `
            <div id="category-filter-modal" class="modal-overlay" onclick="this.remove()">
                <div class="modal-content glass" onclick="event.stopPropagation()">
                    <div class="modal-header">
                        <h3>Kategori Seçin</h3>
                        <i class="fas fa-times" onclick="document.getElementById('category-filter-modal').remove()"></i>
                    </div>
                    <div class="category-select-list">
                        ${options}
                    </div>
                </div>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHtml);
    },

    setShareCategoryFilter: function (category) {
        this.state.shareCategoryFilter = category;
        const modal = document.getElementById('category-filter-modal');
        if (modal) modal.remove();

        const catBtn = document.querySelector('[onclick="app.toggleShareCategorySelect()"]');
        if (catBtn) {
            if (category) {
                catBtn.classList.add('active');
                catBtn.innerHTML = `<i class="fas fa-layer-group"></i> ${category}`;
            } else {
                catBtn.classList.remove('active');
                catBtn.innerHTML = `<i class="fas fa-layer-group"></i> Kategori`;
            }
        }

        this.applyShareFilters();
    },

    showShareModal: function (type) {
        if (!this.checkAuth('Paylaşım yapmak için lütfen giriş yapın.')) return;

        this.state.currentShareType = type;
        const modal = document.getElementById('modal-share-post');
        const titleEl = document.getElementById('share-modal-title');
        const urgentContainer = document.getElementById('share-urgent-container');
        const contentInput = document.getElementById('share-input-content');

        const titles = { paylas: 'Yeni Paylaşım 🎁', ihtiyac: 'İhtiyacım Var 🙋', takas: 'Takas Teklifi 🔄' };
        const placeholders = {
            paylas: 'Eşyanızı kısaca tanıtın (Örn: Sağlam durumda çalışma masası)',
            ihtiyac: 'Neye ihtiyacınız var? (Örn: Bebek arabasına ihtiyacım var)',
            takas: 'Ne ile neyi takas etmek istersiniz? (Örn: PS4 konsolumu Bisiklet ile takas edebilirim)'
        };

        if (titleEl) titleEl.textContent = titles[type];
        if (contentInput) {
            contentInput.placeholder = placeholders[type];
            contentInput.value = '';
        }
        if (urgentContainer) urgentContainer.style.display = (type === 'ihtiyac' ? 'flex' : 'none');

        const catSelect = document.getElementById('share-select-category');
        if (catSelect) catSelect.value = 'Diğer';

        if (modal) modal.style.display = 'flex';

        // Load locations if not loaded
        this.loadLocationData();
    },

    closeShareModal: function () {
        const modal = document.getElementById('modal-share-post');
        if (modal) modal.style.display = 'none';
    },

    // --- Report Ad Logic ---
    openReportModal: function (productId) {
        this._reportingAdId = productId;
        const modal = document.getElementById('modal-report');
        if (modal) {
            modal.style.display = 'flex';
            // Formu temizle
            const note = document.getElementById('report-note');
            if (note) note.value = '';
            document.querySelectorAll('input[name="report-reason"]').forEach(input => input.checked = false);
        }
    },

    closeReportModal: function () {
        const modal = document.getElementById('modal-report');
        if (modal) modal.style.display = 'none';
        this._reportingAdId = null;
    },

    submitReport: async function () {
        const productId = this._reportingAdId;
        const reasonInput = document.querySelector('input[name="report-reason"]:checked');
        const note = document.getElementById('report-note') ? document.getElementById('report-note').value : '';

        if (!reasonInput) {
            alert('Lütfen bir şikayet nedeni seçin.');
            return;
        }

        const reason = reasonInput.value;

        try {
            const reportData = {
                productId: productId,
                reason: reason,
                note: note,
                reporterId: this.state.user ? this.state.user.uid : 'anonim',
                reporterEmail: this.state.user ? this.state.user.email : 'anonim',
                createdAt: firebase.firestore.FieldValue.serverTimestamp(),
                status: 'pending'
            };

            await firebase.firestore().collection('reports').add(reportData);

            alert('Şikayetiniz bize ulaştı. Teşekkür ederiz.');
            this.closeReportModal();
        } catch (error) {
            console.error('Rapor gönderilirken hata:', error);
            alert('Bir hata oluştu, lütfen tekrar deneyin.');
        }
    },

    // --- Info Modals Logic ---
    openForbiddenItemsModal: function () {
        const modal = document.getElementById('modal-forbidden-items');
        if (modal) modal.style.display = 'flex';
    },

    closeForbiddenItemsModal: function () {
        const modal = document.getElementById('modal-forbidden-items');
        if (modal) modal.style.display = 'none';
    },

    openTermsModal: function () {
        const modal = document.getElementById('modal-terms');
        if (modal) modal.style.display = 'flex';
    },

    closeTermsModal: function () {
        const modal = document.getElementById('modal-terms');
        if (modal) modal.style.display = 'none';
    },

    loadLocationData: async function () {
        // Eğer veriler zaten varsa sadece render et ve çık
        if (this.state.trProvinces && this.state.trProvinces.length > 0) {
            this.renderShareCities();
            this.renderShareFilterCities();
            return;
        }

        // Önce hemen fallback ile doldur ki kullanıcı boş liste görmesin
        this.state.trProvinces = this.state.cities.map((c, i) => ({
            id: i + 1,
            name: c,
            districts: []
        }));
        this.renderShareCities();
        this.renderShareFilterCities();

        try {
            // TurkiyeAPI ile güncel verileri çekmeyi dene (5 saniye timeout)
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 5000);

            const resp = await fetch('https://turkiyeapi.dev/api/v1/provinces', { signal: controller.signal });
            clearTimeout(timeoutId);

            if (!resp.ok) throw new Error('API hatası');
            const result = await resp.json();

            if (result.data && result.data.length > 0) {
                this.state.trProvinces = result.data;
                this.renderShareCities();
                this.renderShareFilterCities();
            }
        } catch (e) {
            console.warn('TurkiyeAPI error (using fallback):', e);
            // Fallback zaten yüklendiği için bir şey yapmaya gerek yok
        }
    },

    renderShareCities: function () {
        const citySelect = document.getElementById('share-select-city');
        if (!citySelect || !this.state.trProvinces) return;

        let html = '<option value="">İl Seçin</option>';
        this.state.trProvinces.forEach(province => {
            html += `<option value="${province.id}">${province.name}</option>`;
        });
        citySelect.innerHTML = html;
        document.getElementById('share-select-district').innerHTML = '<option value="">İlçe Seçin</option>';
        document.getElementById('share-select-neighborhood').innerHTML = '<option value="">Mahalle Seçin</option>';
    },

    handleShareCityChange: async function () {
        const provinceId = document.getElementById('share-select-city').value;
        const districtSelect = document.getElementById('share-select-district');
        const neighborhoodSelect = document.getElementById('share-select-neighborhood');
        if (!districtSelect) return;

        districtSelect.innerHTML = '<option value="">Yükleniyor...</option>';
        neighborhoodSelect.innerHTML = '<option value="">Mahalle Seçin</option>';

        if (provinceId === "") {
            districtSelect.innerHTML = '<option value="">İlçe Seçin</option>';
            return;
        }

        try {
            // TurkiyeAPI - İlçeleri çek
            const resp = await fetch(`https://turkiyeapi.dev/api/v1/provinces/${provinceId}`);
            if (!resp.ok) throw new Error('İlçe verisi alınamadı');
            const result = await resp.json();
            const districts = result.data.districts || [];

            this.state.currentDistricts = districts;

            let html = '<option value="">İlçe Seçin</option>';
            districts.forEach(dist => {
                html += `<option value="${dist.id}">${dist.name}</option>`;
            });
            districtSelect.innerHTML = html;
        } catch (e) {
            console.error('District fetch error:', e);
            districtSelect.innerHTML = '<option value="">İlçe yüklenemedi</option>';
        }
    },

    handleShareDistrictChange: async function () {
        const districtId = document.getElementById('share-select-district').value;
        const neighborhoodSelect = document.getElementById('share-select-neighborhood');
        if (!neighborhoodSelect) return;

        neighborhoodSelect.innerHTML = '<option value="">Yükleniyor...</option>';

        if (districtId === "") {
            neighborhoodSelect.innerHTML = '<option value="">Mahalle Seçin</option>';
            return;
        }

        try {
            // TurkiyeAPI - Mahalleleri çek
            const resp = await fetch(`https://turkiyeapi.dev/api/v1/districts/${districtId}`);
            if (!resp.ok) throw new Error('Mahalle verisi alınamadı');
            const result = await resp.json();
            const neighborhoods = result.data.neighborhoods || [];
            const villages = result.data.villages || [];

            // Mahalle ve köyleri birleştir
            const allLocations = [...neighborhoods, ...villages];

            let html = '<option value="">Mahalle Seçin</option>';
            allLocations.forEach(loc => {
                html += `<option value="${loc.name}">${loc.name}</option>`;
            });
            neighborhoodSelect.innerHTML = html;
        } catch (e) {
            console.error('Neighborhood fetch error:', e);
            neighborhoodSelect.innerHTML = '<option value="">Mahalle yüklenemedi</option>';
        }
    },

    renderPazarCities: function () {
        const citySelect = document.getElementById('pazar-city');
        if (!citySelect || !this.state.trProvinces) {
            this.loadLocationData().then(() => this.renderPazarCities());
            return;
        }

        let html = '<option value="">İl Seçin</option>';
        this.state.trProvinces.forEach(province => {
            html += `<option value="${province.id}">${province.name}</option>`;
        });
        citySelect.innerHTML = html;

        // Eğer kullanıcının ili varsa otomatik seç
        if (this.state.user && this.state.user.city) {
            const province = this.state.trProvinces.find(p => p.name === this.state.user.city);
            if (province) {
                citySelect.value = province.id;
                this.handlePazarCityChange();
            }
        }
    },

    handlePazarCityChange: async function () {
        const provinceId = document.getElementById('pazar-city').value;
        const districtSelect = document.getElementById('pazar-district');
        const neighborhoodSelect = document.getElementById('pazar-neighborhood');
        if (!districtSelect) return;

        districtSelect.innerHTML = '<option value="">Yükleniyor...</option>';
        neighborhoodSelect.innerHTML = '<option value="">Mahalle Seçin</option>';

        if (provinceId === "") {
            districtSelect.innerHTML = '<option value="">İlçe Seçin</option>';
            return;
        }

        try {
            const resp = await fetch(`https://turkiyeapi.dev/api/v1/provinces/${provinceId}`);
            if (!resp.ok) throw new Error('İlçe verisi alınamadı');
            const result = await resp.json();
            const districts = result.data.districts || [];

            let html = '<option value="">İlçe Seçin</option>';
            districts.forEach(dist => {
                html += `<option value="${dist.id}">${dist.name}</option>`;
            });
            districtSelect.innerHTML = html;

            // Eğer kullanıcının ilçesi varsa otomatik seç
            if (this.state.user && this.state.user.district) {
                const district = districts.find(d => d.name === this.state.user.district);
                if (district) {
                    districtSelect.value = district.id;
                    this.handlePazarDistrictChange();
                }
            }
        } catch (e) {
            console.error('Pazar District fetch error:', e);
            districtSelect.innerHTML = '<option value="">İlçe yüklenemedi</option>';
        }
    },

    handlePazarDistrictChange: async function () {
        const districtId = document.getElementById('pazar-district').value;
        const neighborhoodSelect = document.getElementById('pazar-neighborhood');
        if (!neighborhoodSelect) return;

        neighborhoodSelect.innerHTML = '<option value="">Yükleniyor...</option>';

        if (districtId === "") {
            neighborhoodSelect.innerHTML = '<option value="">Mahalle Seçin</option>';
            return;
        }

        try {
            const resp = await fetch(`https://turkiyeapi.dev/api/v1/districts/${districtId}`);
            if (!resp.ok) throw new Error('Mahalle verisi alınamadı');
            const result = await resp.json();
            const neighborhoods = result.data.neighborhoods || [];

            let html = '<option value="">Mahalle Seçin</option>';
            neighborhoods.forEach(n => {
                html += `<option value="${n.name}">${n.name}</option>`;
            });
            neighborhoodSelect.innerHTML = html;

            // Eğer kullanıcının mahallesi varsa otomatik seç
            if (this.state.user && this.state.user.neighborhood) {
                neighborhoodSelect.value = this.state.user.neighborhood;
            }
        } catch (e) {
            console.error('Pazar Neighborhood fetch error:', e);
            neighborhoodSelect.innerHTML = '<option value="">Mahalle yüklenemedi</option>';
        }
    },

