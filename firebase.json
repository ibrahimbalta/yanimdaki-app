{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "allure-results/**",
      "allure-report/**",
      "playwright-report/**",
      "test-results/**",
      "cloud-reports/**",
      "tests/**",
      "scripts/**",
      "**/*.exe",
      "**/*.apk",
      "firebase.exe",
      "firebase_v2.exe",
      "node.exe",
      "*.backup",
      "yanimdaki-firebase-adminsdk-*.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/app.html"
      }
    ]
  }
}